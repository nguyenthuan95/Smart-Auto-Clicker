    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "package com.example.engine\n\nimport android.content.Context\nimport android.graphics.Rect\nimport android.os.Build\nimport android.os.CombinedVibration\nimport android.os.VibrationEffect\nimport android.os.Vibrator\nimport android.os.VibratorManager\nimport com.example.data.model.MacroEntity\nimport com.example.data.model.ScriptEntity\nimport kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.Job\nimport kotlinx.coroutines.delay\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport kotlinx.coroutines.isActive\nimport kotlinx.coroutines.launch\n\nenum class ExecutionStatus {\n    IDLE,       // S\341\272\265n s\303\240ng / \304\220\303\243 d\341\273\253ng\n    RUNNING,    // \304\220ang th\341\273\261c thi\n    PAUSED      // T\341\272\241m d\341\273\253ng\n}\n\nobject ExecutionManager {\n\n    private val scope = CoroutineScope(Dispatchers.Default)\n    private var activeJob: Job? = null\n    private var timerJob: Job? = null\n\n    private val _executionStatus = MutableStateFlow(ExecutionStatus.IDLE)\n    val executionStatus: StateFlow<ExecutionStatus> = _executionStatus.asStateFlow()\n\n    private val _isRunning = MutableStateFlow(false)\n    val isRunning: StateFlow<Boolean> = _isRunning.asStateFlow()\n\n    private val _isPaused = MutableStateFlow(false)\n    val isPaused: StateFlow<Boolean> = _isPaused.asStateFlow()\n\n    private val _statusText = MutableStateFlow(\"S\341\272\265n s\303\240ng\")\n    val statusText: StateFlow<String> = _statusText.asStateFlow()\n\n    // B\341\273\231 \304\221\341\272\277m s\341\273\221 l\341\272\247n l\341\272\267p v\303\240 th\341\273\235i gian \304\221\303\243 ch\341\272\241y\n    private val _loopCount = MutableStateFlow(0)\n    val loopCount: StateFlow<Int> = _loopCount.asStateFlow()\n\n    private val _elapsedSeconds = MutableStateFlow(0L)\n    val elapsedSeconds: StateFlow<Long> = _elapsedSeconds.asStateFlow()\n\n    // T\341\273\215a \304\221\341\273\231 bounding box c\341\273\247a bong b\303\263ng n\341\273\225i tr\303\252n m\303\240n h\303\254nh \304\221\341\273\203 lo\341\272\241i tr\341\273\253 OCR v\303\240 auto-click\n    @Volatile\n    var floatingBubbleRect: Rect? = null\n\n    // Callback \341\272\251n t\341\272\241m th\341\273\235i bong b\303\263ng khi ch\341\273\245p m\303\240n h\303\254nh OCR\n    var onTemporarilyHideBubble: ((hide: Boolean) -> Unit)? = null\n\n    // L\306\260u macro ho\341\272\267c script ch\341\272\241y g\341\272\247n nh\341\272\245t \304\221\341\273\203 h\341\273\227 tr\341\273\243 b\341\272\255t/t\341\272\257t nhanh\n    var lastMacro: MacroEntity? = null\n    var lastScript: ScriptEntity? = null\n\n    /**\n     * Ki\341\273\203m tra xem \304\221i\341\273\203m (x, y) c\303\263 n\341\272\261m trong v\303\271ng bong b\303\263ng n\341\273\225i hay kh\303\264ng\n     */\n    fun isPointInsideFloatingBubble(x: Float, y: Float): Boolean {\n        val rect = floatingBubbleRect ?: return false\n        // M\341\273\237 r\341\273\231ng th\303\252m 10px v\303\271ng an to\303\240n\n        return x >= (rect.left - 10) && x <= (rect.right + 10) &&\n               y >= (rect.top - 10) && y <= (rect.bottom + 10)\n    }\n\n    fun setLoop(count: Int) {\n        _loopCount.value = count\n    }\n\n    fun incrementLoop() {\n        _loopCount.value += 1\n    }\n\n    private fun startTimer() {\n        timerJob?.cancel()\n        timerJob = scope.launch {\n            while (isActive && _executionStatus.value != ExecutionStatus.IDLE) {\n                delay(1000L)\n                if (_executionStatus.value == ExecutionStatus.RUNNING) {\n                    _elapsedSeconds.value += 1\n                }\n            }\n        }\n    }\n\n    /**\n     * Rung ph\341\272\243n h\341\273\223i x\303\272c gi\303\241c nh\341\272\271 (Haptic Feedback)\n     */\n    fun triggerHaptic(context: Context, longVibrate: Boolean = false) {\n        try {\n            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n                val vm = context.getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as? VibratorManager\n                val vibrator = vm?.defaultVibrator\n                val effect = if (longVibrate) {\n                    VibrationEffect.createOneShot(80, VibrationEffect.DEFAULT_AMPLITUDE)\n                } else {\n                    VibrationEffect.createPredefined(VibrationEffect.EFFECT_CLICK)\n                }\n                vibrator?.vibrate(effect)\n            } else {\n                @Suppress(\"DEPRECATION\")\n                val v = context.getSystemService(Context.VIBRATOR_SERVICE) as? Vibrator\n                @Suppress(\"DEPRECATION\")\n                v?.vibrate(if (longVibrate) 80L else 35L)\n            }\n        } catch (e: Exception) {\n            // Thi\341\272\277t b\341\273\213 kh\303\264ng h\341\273\227 tr\341\273\243 ho\341\272\267c kh\303\264ng c\303\263 quy\341\273\201n rung\n        }\n    }\n\n    fun pause() {\n        if (_executionStatus.value == ExecutionStatus.RUNNING) {\n            _executionStatus.value = ExecutionStatus.PAUSED\n            _isPaused.value = true\n            _statusText.value = \"\304\220ang t\341\272\241m d\341\273\253ng\"\n            LogRepository.info(\"Manager\", \"\304\220\303\243 t\341\272\241m d\341\273\253ng th\341\273\261c thi.\")\n        }\n    }\n\n    fun resume() {\n        if (_executionStatus.value == ExecutionStatus.PAUSED) {\n            _executionStatus.value = ExecutionStatus.RUNNING\n            _isPaused.value = false\n            _statusText.value = \"\304\220ang ti\341\272\277p t\341\273\245c ch\341\272\241y...\"\n            LogRepository.info(\"Manager\", \"\304\220\303\243 ti\341\272\277p t\341\273\245c th\341\273\261c thi.\")\n        }\n    }\n\n    fun stop() {\n        if (_executionStatus.value != ExecutionStatus.IDLE) {\n            activeJob?.cancel()\n            activeJob = null\n            timerJob?.cancel()\n            timerJob = null\n\n            _executionStatus.value = ExecutionStatus.IDLE\n            _isRunning.value = false\n            _isPaused.value = false\n            _statusText.value = \"\304\220\303\243 d\341\273\253ng l\341\272\241i\"\n            _elapsedSeconds.value = 0L\n            _loopCount.value = 0\n            LogRepository.info(\"Manager\", \"\304\220\303\243 d\341\273\253ng ngay l\341\272\255p t\341\273\251c to\303\240n b\341\273\231 t\303\241c v\341\273\245 (Failsafe).\")\n        }\n    }\n\n    fun togglePlayPause(context: Context) {\n        triggerHaptic(context)\n        when (_executionStatus.value) {\n            ExecutionStatus.IDLE -> {\n                // B\341\272\257t \304\221\341\272\247u ch\341\272\241y l\341\272\241i t\303\241c v\341\273\245 g\341\272\247n nh\341\272\245t\n                toggleQuickAction(context)\n            }\n            ExecutionStatus.RUNNING -> {\n                // \304\220ang ch\341\272\241y -> D\341\273\253ng ho\341\272\267c T\341\272\241m d\341\273\253ng\n                stop()\n            }\n            ExecutionStatus.PAUSED -> {\n                resume()\n            }\n        }\n    }\n\n    fun startScript(context: Context, script: ScriptEntity) {\n        stop()\n        lastScript = script\n        _executionStatus.value = ExecutionStatus.RUNNING\n        _isRunning.value = true\n        _isPaused.value = false\n        _loopCount.value = 1\n        _elapsedSeconds.value = 0L\n        _statusText.value = \"\304\220ang ch\341\272\241y script: ${script.name}\"\n        LogRepository.info(\"Manager\", \"B\341\272\257t \304\221\341\272\247u ch\341\272\241y script: ${script.name}\")\n        startTimer()\n\n        activeJob = scope.launch {\n            try {\n                val runner = ScriptRunner(context)\n                runner.execute(script.code)\n            } catch (e: Exception) {\n                LogRepository.error(\"Manager\", \"Script k\341\272\277t th\303\272c: ${e.message}\")\n            } finally {\n                _executionStatus.value = ExecutionStatus.IDLE\n                _isRunning.value = false\n                _isPaused.value = false\n                timerJob?.cancel()\n                _statusText.value = \"Script \304\221\303\243 k\341\272\277t th\303\272c\"\n                LogRepository.info(\"Manager\", \"Script \304\221\303\243 k\341\272\277t th\303\272c.\")\n            }\n        }\n    }\n\n    fun startMacro(context: Context, macro: MacroEntity) {\n        stop()\n        lastMacro = macro\n        _executionStatus.value = ExecutionStatus.RUNNING\n        _isRunning.value = true\n        _isPaused.value = false\n        _loopCount.value = 1\n        _elapsedSeconds.value = 0L\n        _statusText.value = \"\304\220ang ch\341\272\241y macro: ${macro.name}\"\n        LogRepository.info(\"Manager\", \"B\341\272\257t \304\221\341\272\247u ch\341\272\241y macro: ${macro.name}\")\n        startTimer()\n\n        activeJob = scope.launch {\n            try {\n                val runner = MacroRunner(context)\n                runner.execute(macro)\n            } catch (e: Exception) {\n                LogRepository.error(\"Manager\", \"Macro k\341\272\277t th\303\272c: ${e.message}\")\n            } finally {\n                _executionStatus.value = ExecutionStatus.IDLE\n                _isRunning.value = false\n                _isPaused.value = false\n                timerJob?.cancel()\n                _statusText.value = \"Macro \304\221\303\243 k\341\272\277t th\303\272c\"\n                LogRepository.info(\"Manager\", \"Macro \304\221\303\243 k\341\272\277t th\303\272c.\")\n            }\n        }\n    }\n\n    fun toggleQuickAction(context: Context) {\n        if (_executionStatus.value != ExecutionStatus.IDLE) {\n            stop()\n        } else {\n            when {\n                lastMacro != null -> startMacro(context, lastMacro!!)\n                lastScript != null -> startScript(context, lastScript!!)\n                else -> {\n                    _statusText.value = \"Ch\306\260a ch\341\273\215n macro ho\341\272\267c script\"\n                    LogRepository.warn(\"Manager\", \"Ch\306\260a c\303\263 k\341\273\213ch b\341\272\243n n\303\240o \304\221\306\260\341\273\243c ch\341\273\215n \304\221\341\273\203 ch\341\272\241y.\")\n                }\n            }\n        }\n    }\n\n    /**\n     * D\303\240nh cho c\303\241c Runner ki\341\273\203m tra tr\341\272\241ng th\303\241i t\341\272\241m d\341\273\253ng trong qu\303\241 tr\303\254nh th\341\273\261c thi\n     */\n    suspend fun checkPauseState() {\n        while (_executionStatus.value == ExecutionStatus.PAUSED) {\n            delay(200L)\n        }\n    }\n}\n"
    }
