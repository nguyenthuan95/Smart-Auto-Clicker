      name: "create_file"
      arguments_json: "{\"Content\":\"package com.example.ui.screens\\n\\nimport android.widget.Toast\\nimport androidx.compose.foundation.clickable\\nimport androidx.compose.foundation.layout.*\\nimport androidx.compose.foundation.lazy.LazyColumn\\nimport androidx.compose.foundation.lazy.items\\nimport androidx.compose.foundation.rememberScrollState\\nimport androidx.compose.foundation.shape.RoundedCornerShape\\nimport androidx.compose.foundation.verticalScroll\\nimport androidx.compose.material.icons.Icons\\nimport androidx.compose.material.icons.filled.*\\nimport androidx.compose.material3.*\\nimport androidx.compose.runtime.*\\nimport androidx.compose.ui.Alignment\\nimport androidx.compose.ui.Modifier\\nimport androidx.compose.ui.platform.LocalContext\\nimport androidx.compose.ui.platform.testTag\\nimport androidx.compose.ui.text.font.FontWeight\\nimport androidx.compose.ui.unit.dp\\nimport androidx.compose.ui.unit.sp\\nimport androidx.lifecycle.compose.collectAsStateWithLifecycle\\nimport com.example.data.database.AppRepository\\nimport com.example.data.model.MacroEntity\\nimport com.example.data.model.MacroStep\\nimport com.example.data.model.MatchType\\nimport com.example.data.model.StepType\\nimport com.example.engine.ExecutionManager\\nimport com.google.gson.Gson\\nimport com.google.gson.reflect.TypeToken\\nimport kotlinx.coroutines.launch\\n\\n@OptIn(ExperimentalMaterial3Api::class)\\n@Composable\\nfun MacroScreen(\\n    repository: AppRepository\\n) {\\n    val context = LocalContext.current\\n    val coroutineScope = rememberCoroutineScope()\\n    val gson = remember { Gson() }\\n\\n    val macros by repository.allMacros.collectAsStateWithLifecycle(initialValue = emptyList())\\n    val isRunning by ExecutionManager.isRunning.collectAsStateWithLifecycle()\\n\\n    var showEditDialog by remember { mutableStateOf(false) }\\n    var editingMacro by remember { mutableStateOf<MacroEntity?>(null) }\\n\\n    Scaffold(\\n        floatingActionButton = {\\n            ExtendedFloatingActionButton(\\n                onClick = {\\n                    editingMacro = null\\n                    showEditDialog = true\\n                },\\n                icon = { Icon(Icons.Default.Add, contentDescription = null) },\\n                text = { Text(\\\"T\341\272\241o Macro M\341\273\233i\\\") },\\n                modifier = Modifier.testTag(\\\"add_macro_fab\\\")\\n            )\\n        }\\n    ) { padding ->\\n        Box(\\n            modifier = Modifier\\n                .fillMaxSize()\\n                .padding(padding)\\n        ) {\\n            if (macros.isEmpty()) {\\n                Box(\\n                    modifier = Modifier.fillMaxSize(),\\n                    contentAlignment = Alignment.Center\\n                ) {\\n                    Column(\\n                        horizontalAlignment = Alignment.CenterHorizontally,\\n                        verticalArrangement = Arrangement.spacedBy(8.dp)\\n                    ) {\\n                        Icon(\\n                            Icons.Default.PlaylistAdd,\\n                            contentDescription = null,\\n                            modifier = Modifier.size(64.dp),\\n                            tint = MaterialTheme.colorScheme.outline\\n                        )\\n                        Text(\\n                            text = \\\"Ch\306\260a c\303\263 chu\341\273\227i Macro n\303\240o\\\",\\n                            style = MaterialTheme.typography.titleMedium,\\n                            color = MaterialTheme.colorScheme.outline\\n                        )\\n                        Button(\\n                            onClick = {\\n                                // T\341\272\241o m\341\273\231t macro m\341\272\253u ban \304\221\341\272\247u\\n                                val defaultSteps = listOf(\\n                                    MacroStep(\\n                                        title = \\\"1. B\341\272\245m n\303\272t b\341\272\257t \304\221\341\272\247u\\\",\\n                                        stepType = StepType.CLICK_POINT,\\n                                        x = 540f,\\n                                        y = 1200f,\\n                                        delayAfterMs = 1000L\\n                                    ),\\n                                    MacroStep(\\n                                        title = \\\"2. Ch\341\273\235 ch\341\273\257 \'Th\303\240nh c\303\264ng\' xu\341\272\245t hi\341\273\207n\\\",\\n                                        stepType = StepType.WAIT_TEXT_APPEAR,\\n                                        searchText = \\\"Th\303\240nh c\303\264ng\\\",\\n                                        timeoutMs = 5000L,\\n                                        delayAfterMs = 500L\\n                                    ),\\n                                    MacroStep(\\n                                        title = \\\"3. B\341\272\245m v\303\240o ch\341\273\257 \'X\303\241c nh\341\272\255n\'\\\",\\n                                        stepType = StepType.CLICK_TEXT,\\n                                        searchText = \\\"X\303\241c nh\341\272\255n\\\",\\n                                        delayAfterMs = 500L\\n                                    )\\n                                )\\n                                val sampleMacro = MacroEntity(\\n                                    name = \\\"Macro t\341\273\261 \304\221\341\273\231ng m\341\272\253u\\\",\\n                                    description = \\\"Chu\341\273\227i 3 b\306\260\341\273\233c ch\341\272\241m v\303\240 ki\341\273\203m tra OCR m\341\272\253u\\\",\\n                                    stepsJson = gson.toJson(defaultSteps),\\n                                    repeatCount = 3\\n                                )\\n                                coroutineScope.launch {\\n                                    repository.saveMacro(sampleMacro)\\n                                }\\n                            }\\n                        ) {\\n                            Text(\\\"T\341\272\241o k\341\273\213ch b\341\272\243n m\341\272\253u\\\")\\n                        }\\n                    }\\n                }\\n            } else {\\n                LazyColumn(\\n                    modifier = Modifier\\n                        .fillMaxSize()\\n                        .padding(16.dp),\\n                    verticalArrangement = Arrangement.spacedBy(12.dp)\\n                ) {\\n                    items(macros, key = { it.id }) { macro ->\\n                        val stepCount = try {\\n                            val type = object : TypeToken<List<MacroStep>>() {}.type\\n                            val list: List<MacroStep>? = gson.fromJson(macro.stepsJson, type)\\n                            list?.size ?: 0\\n                        } catch (e: Exception) { 0 }\\n\\n                        Card(\\n                            modifier = Modifier\\n                                .fillMaxWidth()\\n                                .testTag(\\\"macro_item_${macro.id}\\\"),\\n                            shape = RoundedCornerShape(16.dp)\\n                        ) {\\n                            Column(\\n                                modifier = Modifier.padding(16.dp),\\n                                verticalArrangement = Arrangement.spacedBy(8.dp)\\n                            ) {\\n                                Row(\\n                                    modifier = Modifier.fillMaxWidth(),\\n                                    horizontalArrangement = Arrangement.SpaceBetween,\\n                                    verticalAlignment = Alignment.CenterVertically\\n                                ) {\\n                                    Column(modifier = Modifier.weight(1f)) {\\n                                        Text(\\n                                            text = macro.name,\\n                                            style = MaterialTheme.typography.titleMedium,\\n                                            fontWeight = FontWeight.Bold\\n                                        )\\n                                        if (macro.description.isNotEmpty()) {\\n                                            Text(\\n                                                text = macro.description,\\n                                                style = MaterialTheme.typography.bodySmall,\\n                                                color = MaterialTheme.colorScheme.onSurfaceVariant\\n                                            )\\n                                        }\\n                                    }\\n\\n                                    Surface(\\n                                        shape = RoundedCornerShape(8.dp),\\n                                        color = MaterialTheme.colorScheme.primaryContainer\\n                                    ) {\\n                                        Text(\\n                                            text = \\\"$stepCount b\306\260\341\273\233c \342\200\242 L\341\272\267p ${if (macro.repeatCount == 0) \\\"\342\210\236\\\" else \\\"${macro.repeatCount}x\\\"}\\\",\\n                                            modifier = Modifier.padding(horizontal = 8.dp, vertical = 4.dp),\\n                                            style = MaterialTheme.typography.labelSmall,\\n                                            color = MaterialTheme.colorScheme.onPrimaryContainer\\n                                        )\\n                                    }\\n                                }\\n\\n                                Row(\\n                                    modifier = Modifier.fillMaxWidth(),\\n                                    horizontalArrangement = Arrangement.spacedBy(8.dp),\\n                                    verticalAlignment = Alignment.CenterVertically\\n                                ) {\\n                                    Button(\\n                                        onClick = {\\n                                            if (isRunning) {\\n                                                ExecutionManager.stop()\\n                                            } else {\\n                                                ExecutionManager.startMacro(context, macro)\\n                                            }\\n                                        },\\n                                        modifier = Modifier.weight(1f)\\n                                    ) {\\n                                        Icon(\\n                                            imageVector = if (isRunning && ExecutionManager.lastMacro?.id == macro.id) Icons.Default.Stop else Icons.Default.PlayArrow,\\n                                            contentDescription = null\\n                                        )\\n                                        Spacer(Modifier.width(8.dp))\\n                                        Text(if (isRunning && ExecutionManager.lastMacro?.id == macro.id) \\\"D\341\273\253ng\\\" else \\\"Ch\341\272\241y\\\")\\n                                    }\\n\\n                                    IconButton(\\n                                        onClick = {\\n                                            editingMacro = macro\\n                                            showEditDialog = true\\n                                        }\\n                                    ) {\\n                                        Icon(Icons.Default.Edit, contentDescription = \\\"S\341\273\255a\\\")\\n                                    }\\n\\n                                    IconButton(\\n                                        onClick = {\\n                                            coroutineScope.launch {\\n                                                repository.deleteMacro(macro)\\n                                            }\\n                                        }\\n                                    ) {\\n                                        Icon(Icons.Default.Delete, contentDescription = \\\"X\303\263a\\\", tint = MaterialTheme.colorScheme.error)\\n                                    }\\n                                }\\n                            }\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n    }\\n\\n    // Dialog t\341\272\241o / ch\341\273\211nh s\341\273\255a Macro\\n    if (showEditDialog) {\\n        MacroEditorDialog(\\n            macro = editingMacro,\\n            onDismiss = { showEditDialog = false },\\n            onSave = { updatedMacro ->\\n                coroutineScope.launch {\\n                    if (updatedMacro.id == 0L) {\\n                        repository.saveMacro(updatedMacro)\\n                    } else {\\n                        repository.updateMacro(updatedMacro)\\n                    }\\n                }\\n                showEditDialog = false\\n            }\\n        )\\n    }\\n}\\n\\n@OptIn(ExperimentalMaterial3Api::class)\\n@Composable\\nfun MacroEditorDialog(\\n    macro: MacroEntity?,\\n    onDismiss: () -> Unit,\\n    onSave: (MacroEntity) -> Unit\\n) {\\n    val gson = remember { Gson() }\\n    var name by remember { mutableStateOf(macro?.name ?: \\\"\\\") }\\n    var description by remember { mutableStateOf(macro?.description ?: \\\"\\\") }\\n    var repeatCountText by remember { mutableStateOf((macro?.repeatCount ?: 1).toString()) }\\n    var intervalMsText by remember { mutableStateOf((macro?.intervalBetweenLoopsMs ?: 1000L).toString()) }\\n    var stopOnError by remember { mutableStateOf(macro?.stopOnError ?: true) }\\n\\n    val steps = remember {\\n        val initialList: MutableList<MacroStep> = if (macro != null && macro.stepsJson.isNotEmpty()) {\\n            try {\\n                val type = object : TypeToken<List<MacroStep>>() {}.type\\n                gson.fromJson(macro.stepsJson, type) ?: mutableListOf()\\n            } catch (e: Exception) { mutableListOf() }\\n        } else {\\n            mutableListOf(\\n                MacroStep(title = \\\"B\306\260\341\273\233c 1: Ch\341\272\241m \304\221i\341\273\203m\\\", stepType = StepType.CLICK_POINT, x = 500f, y = 1000f)\\n            )\\n        }\\n        mutableStateListOf<MacroStep>().apply { addAll(initialList) }\\n    }\\n\\n    var editingStepIndex by remember { mutableStateOf<Int?>(null) }\\n\\n    AlertDialog(\\n        onDismissRequest = onDismiss,\\n        title = { Text(if (macro == null) \\\"T\341\272\241o Macro M\341\273\233i\\\" else \\\"Ch\341\273\211nh S\341\273\255a Macro\\\") },\\n        text = {\\n            Column(\\n                modifier = Modifier\\n                    .fillMaxWidth()\\n                    .verticalScroll(rememberScrollState()),\\n                verticalArrangement = Arrangement.spacedBy(12.dp)\\n            ) {\\n                OutlinedTextField(\\n                    value = name,\\n                    onValueChange = { name = it },\\n                    label = { Text(\\\"T\303\252n Macro\\\") },\\n                    singleLine = true,\\n                    modifier = Modifier.fillMaxWidth()\\n                )\\n\\n                OutlinedTextField(\\n                    value = description,\\n                    onValueChange = { description = it },\\n                    label = { Text(\\\"M\303\264 t\341\272\243\\\") },\\n                    singleLine = true,\\n                    modifier = Modifier.fillMaxWidth()\\n                )\\n\\n                Row(\\n                    modifier = Modifier.fillMaxWidth(),\\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\\n                ) {\\n                    OutlinedTextField(\\n                        value = repeatCountText,\\n                        onValueChange = { repeatCountText = it },\\n                        label = { Text(\\\"L\341\272\267p (0 = v\303\264 h\341\272\241n)\\\") },\\n                        modifier = Modifier.weight(1f)\\n                    )\\n\\n                    OutlinedTextField(\\n                        value = intervalMsText,\\n                        onValueChange = { intervalMsText = it },\\n                        label = { Text(\\\"Ngh\341\273\211 v\303\262ng (ms)\\\") },\\n                        modifier = Modifier.weight(1f)\\n                    )\\n                }\\n\\n                Row(\\n                    verticalAlignment = Alignment.CenterVertically,\\n                    horizontalArrangement = Arrangement.SpaceBetween,\\n                    modifier = Modifier.fillMaxWidth()\\n                ) {\\n                    Text(\\\"D\341\273\253ng khi g\341\272\267p l\341\273\227i\\\", style = MaterialTheme.typography.bodyMedium)\\n                    Switch(checked = stopOnError, onCheckedChange = { stopOnError = it })\\n                }\\n\\n                Divider()\\n\\n                Row(\\n                    modifier = Modifier.fillMaxWidth(),\\n                    horizontalArrangement = Arrangement.SpaceBetween,\\n                    verticalAlignment = Alignment.CenterVertically\\n                ) {\\n                    Text(\\\"Danh s\303\241ch b\306\260\341\273\233c (${steps.size})\\\", fontWeight = FontWeight.Bold)\\n                    TextButton(\\n                        onClick = {\\n                            steps.add(\\n                                MacroStep(\\n                                    title = \\\"B\306\260\341\273\233c ${steps.size + 1}\\\",\\n                                    stepType = StepType.CLICK_POINT,\\n                                    x = 540f,\\n                                    y = 1000f\\n                                )\\n                            )\\n                        }\\n                    ) {\\n                        Icon(Icons.Default.Add, contentDescription = null)\\n                        Text(\\\"Th\303\252m b\306\260\341\273\233c\\\")\\n                    }\\n                }\\n\\n                steps.forEachIndexed { index, step ->\\n                    Card(\\n                        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant),\\n                        modifier = Modifier.fillMaxWidth()\\n                    ) {\\n                        Column(modifier = Modifier.padding(12.dp)) {\\n                            Row(\\n                                modifier = Modifier.fillMaxWidth(),\\n                                horizontalArrangement = Arrangement.SpaceBetween,\\n                                verticalAlignment = Alignment.CenterVertically\\n                            ) {\\n                                Text(\\n                                    text = \\\"${index + 1}. ${step.title} (${step.stepType.name})\\\",\\n                                    style = MaterialTheme.typography.bodyMedium,\\n                                    fontWeight = FontWeight.SemiBold\\n                                )\\n\\n                                Row {\\n                                    IconButton(onClick = { editingStepIndex = index }) {\\n                                        Icon(Icons.Default.Settings, contentDescription = \\\"C\341\272\245u h\303\254nh b\306\260\341\273\233c\\\", modifier = Modifier.size(18.dp))\\n                                    }\\n                                    IconButton(onClick = { steps.removeAt(index) }) {\\n                                        Icon(Icons.Default.Delete, contentDescription = \\\"X\303\263a b\306\260\341\273\233c\\\", modifier = Modifier.size(18.dp), tint = MaterialTheme.colorScheme.error)\\n                                    }\\n                                }\\n                            }\\n\\n                            Text(\\n                                text = when (step.stepType) {\\n                                    StepType.CLICK_POINT, StepType.DOUBLE_CLICK, StepType.LONG_PRESS ->\\n                                        \\\"T\341\273\215a \304\221\341\273\231: (${step.x.toInt()}, ${step.y.toInt()}) \342\200\242 Tr\341\273\205: ${step.delayAfterMs}ms\\\"\\n                                    StepType.SWIPE ->\\n                                        \\\"T\341\273\253 (${step.x.toInt()}, ${step.y.toInt()}) \304\221\341\272\277n (${step.endX.toInt()}, ${step.endY.toInt()})\\\"\\n                                    StepType.WAIT_TEXT_APPEAR, StepType.WAIT_TEXT_DISAPPEAR, StepType.CLICK_TEXT ->\\n                                        \\\"Ch\341\273\257 OCR: \'${step.searchText}\' (${step.matchType}) \342\200\242 Timeout: ${step.timeoutMs}ms\\\"\\n                                    StepType.PASTE_CLIPBOARD ->\\n                                        \\\"D\303\241n v\303\240o (${step.x.toInt()}, ${step.y.toInt()}): ${if (step.customTextToPaste.isEmpty()) \\\"[Clipboard]\\\" else step.customTextToPaste}\\\"\\n                                    StepType.DELAY ->\\n                                        \\\"Ngh\341\273\211 ${step.durationMs}ms\\\"\\n                                },\\n                                style = MaterialTheme.typography.bodySmall,\\n                                color = MaterialTheme.colorScheme.onSurfaceVariant\\n                            )\\n                        }\\n                    }\\n                }\\n            }\\n        },\\n        confirmButton = {\\n            Button(\\n                onClick = {\\n                    if (name.isBlank()) return@Button\\n                    val finalMacro = MacroEntity(\\n                        id = macro?.id ?: 0L,\\n                        name = name.trim(),\\n                        description = description.trim(),\\n                        stepsJson = gson.toJson(steps.toList()),\\n                        repeatCount = repeatCountText.toIntOrNull() ?: 1,\\n                        intervalBetweenLoopsMs = intervalMsText.toLongOrNull() ?: 1000L,\\n                        stopOnError = stopOnError\\n                    )\\n                    onSave(finalMacro)\\n                }\\n            ) {\\n                Text(\\\"L\306\260u Macro\\\")\\n            }\\n        },\\n        dismissButton = {\\n            TextButton(onClick = onDismiss) {\\n                Text(\\\"H\341\273\247y\\\")\\n            }\\n        }\\n    )\\n\\n    // Dialog ch\341\273\211nh s\341\273\255a chi ti\341\272\277t t\341\273\253ng b\306\260\341\273\233c\\n    if (editingStepIndex != null && editingStepIndex!! in steps.indices) {\\n        val index = editingStepIndex!!\\n        val currentStep = steps[index]\\n        StepEditorDialog(\\n            step = currentStep,\\n            onDismiss = { editingStepIndex = null },\\n            onSaveStep = { updatedStep ->\\n                steps[index] = updatedStep\\n                editingStepIndex = null\\n            }\\n        )\\n    }\\n}\\n\\n@OptIn(ExperimentalMaterial3Api::class)\\n@Composable\\nfun StepEditorDialog(\\n    step: MacroStep,\\n    onDismiss: () -> Unit,\\n    onSaveStep: (MacroStep) -> Unit\\n) {\\n    var title by remember { mutableStateOf(step.title) }\\n    var stepType by remember { mutableStateOf(step.stepType) }\\n    var xText by remember { mutableStateOf(step.x.toInt().toString()) }\\n    var yText by remember { mutableStateOf(step.y.toInt().toString()) }\\n    var endXText by remember { mutableStateOf(step.endX.toInt().toString()) }\\n    var endYText by remember { mutableStateOf(step.endY.toInt().toString()) }\\n    var durationText by remember { mutableStateOf(step.durationMs.toString()) }\\n    var delayAfterText by remember { mutableStateOf(step.delayAfterMs.toString()) }\\n    var searchText by remember { mutableStateOf(step.searchText) }\\n    var matchType by remember { mutableStateOf(step.matchType) }\\n    var timeoutText by remember { mutableStateOf(step.timeoutMs.toString()) }\\n    var customPasteText by remember { mutableStateOf(step.customTextToPaste) }\\n\\n    AlertDialog(\\n        onDismissRequest = onDismiss,\\n        title = { Text(\\\"C\341\272\245u H\303\254nh B\306\260\341\273\233c\\\") },\\n        text = {\\n            Column(\\n                modifier = Modifier\\n                    .fillMaxWidth()\\n                    .verticalScroll(rememberScrollState()),\\n                verticalArrangement = Arrangement.spacedBy(10.dp)\\n            ) {\\n                OutlinedTextField(\\n                    value = title,\\n                    onValueChange = { title = it },\\n                    label = { Text(\\\"T\303\252n b\306\260\341\273\233c\\\") },\\n                    singleLine = true,\\n                    modifier = Modifier.fillMaxWidth()\\n                )\\n\\n                // Ch\341\273\215n ki\341\273\203u b\306\260\341\273\233c\\n                Text(\\\"Lo\341\272\241i h\303\240nh \304\221\341\273\231ng:\\\", style = MaterialTheme.typography.bodyMedium, fontWeight = FontWeight.Bold)\\n                var expandedTypeDropdown by remember { mutableStateOf(false) }\\n                ExposedDropdownMenuBox(\\n                    expanded = expandedTypeDropdown,\\n                    onExpandedChange = { expandedTypeDropdown = it }\\n                ) {\\n                    OutlinedTextField(\\n                        value = stepType.name,\\n                        onValueChange = {},\\n                        readOnly = true,\\n                        trailingIcon = { ExposedDropdownMenuDefaults.TrailingIcon(expanded = expandedTypeDropdown) },\\n                        modifier = Modifier\\n                            .fillMaxWidth()\\n                            .menuAnchor()\\n                    )\\n                    ExposedDropdownMenu(\\n                        expanded = expandedTypeDropdown,\\n                        onDismissRequest = { expandedTypeDropdown = false }\\n                    ) {\\n                        StepType.values().forEach { type ->\\n                            DropdownMenuItem(\\n                                text = { Text(type.name) },\\n                                onClick = {\\n                                    stepType = type\\n                                    expandedTypeDropdown = false\\n                                }\\n                            )\\n                        }\\n                    }\\n                }\\n\\n                // C\341\272\245u h\303\254nh t\306\260\306\241ng \341\273\251ng theo lo\341\272\241i b\306\260\341\273\233c\\n                when (stepType) {\\n                    StepType.CLICK_POINT, StepType.DOUBLE_CLICK, StepType.LONG_PRESS -> {\\n                        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\\n                            OutlinedTextField(value = xText, onValueChange = { xText = it }, label = { Text(\\\"X\\\") }, modifier = Modifier.weight(1f))\\n                            OutlinedTextField(value = yText, onValueChange = { yText = it }, label = { Text(\\\"Y\\\") }, modifier = Modifier.weight(1f))\\n                        }\\n                        if (stepType == StepType.LONG_PRESS) {\\n                            OutlinedTextField(value = durationText, onValueChange = { durationText = it }, label = { Text(\\\"Th\341\273\235i gian gi\341\273\257 (ms)\\\") })\\n                        }\\n                    }\\n\\n                    StepType.SWIPE -> {\\n                        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\\n                            OutlinedTextField(value = xText, onValueChange = { xText = it }, label = { Text(\\\"B\341\272\257t \304\221\341\272\247u X\\\") }, modifier = Modifier.weight(1f))\\n                            OutlinedTextField(value = yText, onValueChange = { yText = it }, label = { Text(\\\"B\341\272\257t \304\221\341\272\247u Y\\\") }, modifier = Modifier.weight(1f))\\n                        }\\n                        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\\n                            OutlinedTextField(value = endXText, onValueChange = { endXText = it }, label = { Text(\\\"\304\220\341\272\277n X\\\") }, modifier = Modifier.weight(1f))\\n                            OutlinedTextField(value = endYText, onValueChange = { endYText = it }, label = { Text(\\\"\304\220\341\272\277n Y\\\") }, modifier = Modifier.weight(1f))\\n                        }\\n                        OutlinedTextField(value = durationText, onValueChange = { durationText = it }, label = { Text(\\\"Th\341\273\235i gian vu\341\273\221t (ms)\\\") })\\n                    }\\n\\n                    StepType.WAIT_TEXT_APPEAR, StepType.WAIT_TEXT_DISAPPEAR, StepType.CLICK_TEXT -> {\\n                        OutlinedTextField(\\n                            value = searchText,\\n                            onValueChange = { searchText = it },\\n                            label = { Text(\\\"Chu\341\273\227i t\303\254m ki\341\272\277m (OCR)\\\") },\\n                            modifier = Modifier.fillMaxWidth()\\n                        )\\n                        OutlinedTextField(\\n                            value = timeoutText,\\n                            onValueChange = { timeoutText = it },\\n                            label = { Text(\\\"Th\341\273\235i gian ch\341\273\235 t\341\273\221i \304\221a (ms)\\\") },\\n                            modifier = Modifier.fillMaxWidth()\\n                        )\\n                    }\\n\\n                    StepType.PASTE_CLIPBOARD -> {\\n                        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\\n                            OutlinedTextField(value = xText, onValueChange = { xText = it }, label = { Text(\\\"X focus\\\") }, modifier = Modifier.weight(1f))\\n                            OutlinedTextField(value = yText, onValueChange = { yText = it }, label = { Text(\\\"Y focus\\\") }, modifier = Modifier.weight(1f))\\n                        }\\n                        OutlinedTextField(\\n                            value = customPasteText,\\n                            onValueChange = { customPasteText = it },\\n                            label = { Text(\\\"V\304\203n b\341\272\243n d\303\241n (\304\221\341\273\203 tr\341\273\221ng = l\341\272\245y Clipboard)\\\") },\\n                            modifier = Modifier.fillMaxWidth()\\n                        )\\n                    }\\n\\n                    StepType.DELAY -> {\\n                        OutlinedTextField(\\n                            value = durationText,\\n                            onValueChange = { durationText = it },\\n                            label = { Text(\\\"Th\341\273\235i gian ngh\341\273\211 (ms)\\\") },\\n                            modifier = Modifier.fillMaxWidth()\\n                        )\\n                    }\\n                }\\n\\n                OutlinedTextField(\\n                    value = delayAfterText,\\n                    onValueChange = { delayAfterText = it },\\n                    label = { Text(\\\"Ngh\341\273\211 sau b\306\260\341\273\233c n\303\240y (ms)\\\") },\\n                    modifier = Modifier.fillMaxWidth()\\n                )\\n            }\\n        },\\n        confirmButton = {\\n            Button(\\n                onClick = {\\n                    val updated = step.copy(\\n                        title = title.trim(),\\n                        stepType = stepType,\\n                        x = xText.toFloatOrNull() ?: step.x,\\n                        y = yText.toFloatOrNull() ?: step.y,\\n                        endX = endXText.toFloatOrNull() ?: step.endX,\\n                        endY = endYText.toFloatOrNull() ?: step.endY,\\n                        durationMs = durationText.toLongOrNull() ?: step.durationMs,\\n                        delayAfterMs = delayAfterText.toLongOrNull() ?: step.delayAfterMs,\\n                        searchText = searchText.trim(),\\n                        matchType = matchType,\\n                        timeoutMs = timeoutText.toLongOrNull() ?: step.timeoutMs,\\n                        customTextToPaste = customPasteText\\n                    )\\n                    onSaveStep(updated)\\n                }\\n            ) {\\n                Text(\\\"Xong\\\")\\n            }\\n        },\\n        dismissButton = {\\n            TextButton(onClick = onDismiss) {\\n                Text(\\\"H\341\273\247y\\\")\\n            }\\n        }\\n    )\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/app/src/main/java/com/example/ui/screens/MacroScreen.kt\", \"toolAction\":\"Creating MacroScreen\", \"toolSummary\":\"Create MacroScreen.kt\"}"
