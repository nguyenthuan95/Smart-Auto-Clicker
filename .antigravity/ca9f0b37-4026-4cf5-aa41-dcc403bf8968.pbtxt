      original_chunk {
        target_content: "                // H\306\260\341\273\233ng d\341\272\253n c\341\272\245p quy\341\273\201n\n                Text(\"1. H\306\260\341\273\233ng D\341\272\253n C\341\272\245p Quy\341\273\201n Ho\341\272\241t \304\220\341\273\231ng\", fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.primary)\n\n                GuideStep(\n                    number = \"1\",\n                    title = \"D\341\273\213ch v\341\273\245 H\341\273\227 tr\341\273\243 ti\341\272\277p c\341\272\255n (Accessibility)\",\n                    desc = \"V\303\240o C\303\240i \304\221\341\272\267t h\341\273\207 th\341\273\221ng -> H\341\273\227 tr\341\273\243 ti\341\272\277p c\341\272\255n (Accessibility) -> \341\273\250ng d\341\273\245ng \304\221\303\243 c\303\240i \304\221\341\272\267t -> T\303\254m \'Smart Auto Clicker Service\' v\303\240 G\341\272\241t B\341\272\255t.\"\n                )\n\n                GuideStep(\n                    number = \"2\",\n                    title = \"C\341\273\255a s\341\273\225 n\341\273\225i (Overlay)\",\n                    desc = \"B\341\272\255t quy\341\273\201n \'Xu\341\272\245t hi\341\273\207n tr\303\252n c\303\271ng\' / \'Hi\341\273\203n th\341\273\213 tr\303\252n \341\273\251ng d\341\273\245ng kh\303\241c\' \304\221\341\273\203 thanh c\303\264ng c\341\273\245 \304\221i\341\273\201u khi\341\273\203n v\303\240 t\303\242m ng\341\272\257m c\303\263 th\341\273\203 v\341\272\275 \304\221\303\250 l\303\252n m\303\240n h\303\254nh.\"\n                )\n\n                GuideStep(\n                    number = \"3\",\n                    title = \"Ch\341\273\245p m\303\240n h\303\254nh (MediaProjection)\",\n                    desc = \"Nh\341\272\245n \'C\341\272\245p quy\341\273\201n ch\341\273\245p\' tr\303\252n m\303\240n h\303\254nh ch\303\255nh v\303\240 ch\341\273\215n \'B\341\272\257t \304\221\341\272\247u ngay\'. H\341\273\207 th\341\273\221ng s\341\272\275 t\341\272\241o d\341\273\213ch v\341\273\245 Foreground \304\221\341\273\203 OCR qu\303\251t ch\341\273\257.\"\n                )\n\n                GuideStep(\n                    number = \"4\",\n                    title = \"T\341\272\257t T\341\273\221i \306\260u h\303\263a pin (Battery Optimization)\",\n                    desc = \"Tr\303\252n Xiaomi (MIUI/HyperOS), Oppo, Vivo, Samsung, h\303\243y v\303\240o C\303\240i \304\221\341\272\267t \341\273\251ng d\341\273\245ng -> Ti\341\272\277t ki\341\273\207m pin -> \304\220\341\272\267t th\303\240nh \'Kh\303\264ng h\341\272\241n ch\341\272\277\' v\303\240 b\341\272\255t \'T\341\273\261 kh\341\273\237i ch\341\272\241y\' \304\221\341\273\203 app kh\303\264ng b\341\273\213 t\341\272\257t \304\221\341\273\231t ng\341\273\231t.\"\n                )\n\n                Divider()\n\n                // Ph\303\255m t\341\272\257t kh\341\272\251n c\341\272\245p\n                Text(\"2. Ph\303\255m T\341\272\257t Kh\341\272\251n C\341\272\245p (Failsafe)\", fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.secondary)\n                Text(\n                    text = \"\342\200\242 B\341\272\245m ph\303\255m T\304\203ng/Gi\341\272\243m \303\202m l\306\260\341\273\243ng b\341\272\245t k\341\273\263 l\303\272c n\303\240o \304\221\341\273\203 D\341\273\252NG NGAY L\341\272\254P T\341\273\250C to\303\240n b\341\273\231 macro v\303\240 script.\\n\342\200\242 Nh\341\272\245n n\303\272t \'\342\217\271 D\341\273\253ng\' \304\221\341\273\217 tr\303\252n thanh n\341\273\225i ho\341\272\267c tr\303\252n thanh th\303\264ng b\303\241o h\341\273\207 th\341\273\221ng.\",\n                    style = MaterialTheme.typography.bodySmall\n                )\n\n                Divider()\n\n                // Danh s\303\241ch h\341\272\241n ch\341\272\277 \304\221\303\243 bi\341\272\277t\n                Text(\"3. Danh S\303\241ch H\341\272\241n Ch\341\272\277 \304\220\303\243 Bi\341\272\277t\", fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.error)"
        replacement_content: "                // H\306\260\341\273\233ng d\341\272\253n c\341\272\245p quy\341\273\201n\n                Text(\"1. H\306\260\341\273\233ng D\341\272\253n C\341\272\245p Quy\341\273\201n Ho\341\272\241t \304\220\341\273\231ng\", fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.primary)\n\n                GuideStep(\n                    number = \"1\",\n                    title = \"D\341\273\213ch v\341\273\245 H\341\273\227 tr\341\273\243 ti\341\272\277p c\341\272\255n (Accessibility)\",\n                    desc = \"V\303\240o C\303\240i \304\221\341\272\267t h\341\273\207 th\341\273\221ng -> H\341\273\227 tr\341\273\243 ti\341\272\277p c\341\272\255n (Accessibility) -> \341\273\250ng d\341\273\245ng \304\221\303\243 c\303\240i \304\221\341\272\267t -> T\303\254m \'Smart Auto Clicker Service\' v\303\240 G\341\272\241t B\341\272\255t.\"\n                )\n\n                GuideStep(\n                    number = \"2\",\n                    title = \"C\341\273\255a s\341\273\225 n\341\273\225i (Overlay)\",\n                    desc = \"B\341\272\255t quy\341\273\201n \'Xu\341\272\245t hi\341\273\207n tr\303\252n c\303\271ng\' / \'Hi\341\273\203n th\341\273\213 tr\303\252n \341\273\251ng d\341\273\245ng kh\303\241c\' \304\221\341\273\203 bong b\303\263ng n\341\273\225i Play/Stop v\303\240 t\303\242m ng\341\272\257m c\303\263 th\341\273\203 hi\341\273\203n th\341\273\213 tr\303\252n m\341\273\215i \341\273\251ng d\341\273\245ng.\"\n                )\n\n                GuideStep(\n                    number = \"3\",\n                    title = \"Ch\341\273\245p m\303\240n h\303\254nh (MediaProjection)\",\n                    desc = \"Nh\341\272\245n \'C\341\272\245p quy\341\273\201n ch\341\273\245p\' tr\303\252n m\303\240n h\303\254nh ch\303\255nh v\303\240 ch\341\273\215n \'B\341\272\257t \304\221\341\272\247u ngay\'. H\341\273\207 th\341\273\221ng s\341\272\275 t\341\272\241o d\341\273\213ch v\341\273\245 Foreground \304\221\341\273\203 OCR qu\303\251t ch\341\273\257.\"\n                )\n\n                GuideStep(\n                    number = \"4\",\n                    title = \"T\341\272\257t T\341\273\221i \306\260u h\303\263a pin (Battery Optimization)\",\n                    desc = \"Tr\303\252n Xiaomi (MIUI/HyperOS), Oppo, Vivo, Samsung, h\303\243y v\303\240o C\303\240i \304\221\341\272\267t \341\273\251ng d\341\273\245ng -> Ti\341\272\277t ki\341\273\207m pin -> \304\220\341\272\267t th\303\240nh \'Kh\303\264ng h\341\272\241n ch\341\272\277\' v\303\240 b\341\272\255t \'T\341\273\261 kh\341\273\237i ch\341\272\241y\' \304\221\341\273\203 app kh\303\264ng b\341\273\213 t\341\272\257t \304\221\341\273\231t ng\341\273\231t.\"\n                )\n\n                Divider()\n\n                // H\306\260\341\273\233ng d\341\272\253n s\341\273\255 d\341\273\245ng n\303\272t n\341\273\225i Play/Stop\n                Text(\"2. N\303\272t \304\220i\341\273\201u Khi\341\273\203n N\341\273\225i Play/Stop\", fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.tertiary)\n                Text(\n                    text = \"\342\200\242 Bong b\303\263ng tr\303\262n Play/Stop: Ch\341\272\241m 1 l\341\272\247n \304\221\341\273\203 Ch\341\272\241y/D\341\273\253ng t\303\241c v\341\273\245 g\341\272\247n nh\341\272\245t t\341\273\251c th\303\254 (c\303\263 rung ph\341\272\243n h\341\273\223i).\\n\" +\n                            \"\342\200\242 \304\220\341\273\225i tr\341\272\241ng th\303\241i tr\341\273\261c quan: \342\226\266 Vi\341\273\201n xanh khi s\341\272\265n s\303\240ng, \342\217\271 Vi\341\273\201n \304\221\341\273\217 khi \304\221ang ch\341\272\241y, \342\217\270 Vi\341\273\201n v\303\240ng khi t\341\272\241m d\341\273\253ng.\\n\" +\n                            \"\342\200\242 K\303\251o & T\341\273\261 h\303\255t vi\341\273\201n: K\303\251o bong b\303\263ng t\341\273\233i b\341\272\245t k\341\273\263 \304\221\303\242u tr\303\252n m\303\240n h\303\254nh, th\341\272\243 ra s\341\272\275 t\341\273\261 \304\221\341\273\231ng h\303\255t g\341\273\215n g\303\240ng v\303\240o m\303\251p tr\303\241i/ph\341\272\243i v\303\240 ghi nh\341\273\233 v\341\273\213 tr\303\255.\\n\" +\n                            \"\342\200\242 M\341\273\237 r\341\273\231ng thanh c\303\264ng c\341\273\245: Ch\341\272\241m gi\341\273\257 l\303\242u v\303\240o bong b\303\263ng tr\303\262n \304\221\341\273\203 bung ra thanh c\303\264ng c\341\273\245 (T\341\272\241m d\341\273\253ng, Ch\341\273\215n \304\221i\341\273\203m, Ch\341\273\215n v\303\271ng OCR, M\341\273\237 app, \304\220\303\263ng n\303\272t n\341\273\225i).\\n\" +\n                            \"\342\200\242 B\341\273\231 \304\221\341\272\277m th\303\264ng minh: Badge g\303\263c tr\303\252n hi\341\273\203n th\341\273\213 s\341\273\221 v\303\262ng l\341\272\267p (x3) ho\341\272\267c th\341\273\235i gian (01:25), ch\341\272\241m v\303\240o badge \304\221\341\273\203 chuy\341\273\203n \304\221\341\273\225i.\\n\" +\n                            \"\342\200\242 An to\303\240n OCR & Auto-click: Bong b\303\263ng t\341\273\261 \304\221\341\273\231ng \341\272\251n t\341\272\241m th\341\273\235i (alpha = 0) khi ch\341\273\245p m\303\240n h\303\254nh v\303\240 t\341\273\261 \304\221\341\273\231ng ch\341\272\267n auto-click \304\221\303\250 l\303\252n ch\303\255nh n\303\263!\",\n                    style = MaterialTheme.typography.bodySmall\n                )\n\n                Divider()\n\n                // Ph\303\255m t\341\272\257t kh\341\272\251n c\341\272\245p\n                Text(\"3. Ph\303\255m T\341\272\257t Kh\341\272\251n C\341\272\245p (Failsafe)\", fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.secondary)\n                Text(\n                    text = \"\342\200\242 B\341\272\245m ph\303\255m T\304\203ng/Gi\341\272\243m \303\202m l\306\260\341\273\243ng b\341\272\245t k\341\273\263 l\303\272c n\303\240o \304\221\341\273\203 D\341\273\252NG NGAY L\341\272\254P T\341\273\250C to\303\240n b\341\273\231 macro v\303\240 script.\\n\342\200\242 Nh\341\272\245n n\303\272t \'\342\217\271 D\341\273\253ng\' \304\221\341\273\217 tr\303\252n n\303\272t n\341\273\225i, tr\303\252n m\303\240n h\303\254nh ch\303\255nh ho\341\272\267c tr\303\252n thanh th\303\264ng b\303\241o h\341\273\207 th\341\273\221ng.\",\n                    style = MaterialTheme.typography.bodySmall\n                )\n\n                Divider()\n\n                // Danh s\303\241ch h\341\272\241n ch\341\272\277 \304\221\303\243 bi\341\272\277t\n                Text(\"4. Danh S\303\241ch H\341\272\241n Ch\341\272\277 \304\220\303\243 Bi\341\272\277t\", fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.error)"
