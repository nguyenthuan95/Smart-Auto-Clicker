                                    }\n                                        }\n                                    ) {\n                                        Icon(Icons.Default.Delete, contentDescription = \"X\303\263a\", tint = MaterialTheme.colorScheme.error)\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    // Dialog th\303\252m \304\220i\341\273\203m th\341\273\247 c\303\264ng\n    if (showAddPointDialog) {\n        var pName by remember { mutableStateOf(\"\") }\n        var pX by remember { mutableStateOf(\"540\") }\n        var pY by remember { mutableStateOf(\"1000\") }\n        var pDesc by remember { mutableStateOf(\"\") }\n\n        AlertDialog(\n            onDismissRequest = { showAddPointDialog = false },\n            title = { Text(\"Th\303\252m T\341\273\215a \304\220\341\273\231 \304\220i\341\273\203m\") },\n            text = {\n                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n                    OutlinedTextField(value = pName, onValueChange = { pName = it }, label = { Text(\"T\303\252n \304\221i\341\273\203m\") }, singleLine = true)\n                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n                        OutlinedTextField(value = pX, onValueChange = { pX = it }, label = { Text(\"X (px)\") }, modifier = Modifier.weight(1f))\n                        OutlinedTextField(value = pY, onValueChange = { pY = it }, label = { Text(\"Y (px)\") }, modifier = Modifier.weight(1f))\n                    }\n                    OutlinedTextField(value = pDesc, onValueChange = { pDesc = it }, label = { Text(\"M\303\264 t\341\272\243 ghi ch\303\272\") }, singleLine = true)\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        val xVal = pX.toFloatOrNull() ?: 0f\n                        val yVal = pY.toFloatOrNull() ?: 0f\n                        val point = TargetPoint(\n                            name = pName.trim().ifEmpty { \"\304\220i\341\273\203m ch\341\272\241m\" },\n                            x = xVal,\n                            y = yVal,\n                            description = pDesc.trim()\n                        )\n                        coroutineScope.launch {\n                            repository.savePoint(point)\n                        }\n                        showAddPointDialog = false\n                    }\n                ) {\n                    Text(\"L\306\260u\")\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showAddPointDialog = false }) { Text(\"H\341\273\247y\") }\n            }\n        )\n    }\n\n    // Dialog th\303\252m V\303\271ng ROI th\341\273\247 c\303\264ng\n    if (showAddRoiDialog) {\n        var rName by remember { mutableStateOf(\"\") }\n        var rX by remember { mutableStateOf(\"100\") }\n        var rY by remember { mutableStateOf(\"300\") }\n        var rW by remember { mutableStateOf(\"800\") }\n        var rH by remember { mutableStateOf(\"400\") }\n\n        AlertDialog(\n            onDismissRequest = { showAddRoiDialog = false },\n            title = { Text(\"Th\303\252m V\303\271ng ROI Qu\303\251t OCR\") },\n            text = {\n                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n                    OutlinedTextField(value = rName, onValueChange = { rName = it }, label = { Text(\"T\303\252n v\303\271ng\") }, singleLine = true)\n                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n                        OutlinedTextField(value = rX, onValueChange = { rX = it }, label = { Text(\"X\") }, modifier = Modifier.weight(1f))\n                        OutlinedTextField(value = rY, onValueChange = { rY = it }, label = { Text(\"Y\") }, modifier = Modifier