        target_content: "import org.mozilla.javascript.Context as RhinoContext\nimport org.mozilla.javascript.Function\nimport org.mozilla.javascript.NativeArray\nimport org.mozilla.javascript.NativeObject\nimport org.mozilla.javascript.Scriptable\nimport org.mozilla.javascript.ScriptableObject\nimport kotlin.random.Random\n\nclass ScriptRunner(private val context: Context) {\n\n    private val mainHandler = Handler(Looper.getMainLooper())\n\n    fun execute(scriptSource: String) {\n        val rhino = RhinoContext.enter()\n        try {\n            rhino.optimizationLevel = -1 // Th\303\264ng d\341\273\213ch tr\341\273\261c ti\341\272\277p tr\303\252n Android VM\n            val scope: Scriptable = rhino.initStandardObjects()"
        replacement_content: "import org.mozilla.javascript.Context as RhinoContext\nimport org.mozilla.javascript.ContextFactory\nimport org.mozilla.javascript.Function\nimport org.mozilla.javascript.NativeArray\nimport org.mozilla.javascript.NativeObject\nimport org.mozilla.javascript.Scriptable\nimport org.mozilla.javascript.ScriptableObject\nimport kotlin.random.Random\n\n/**\n * ContextFactory t\303\271y bi\341\272\277n quan s\303\241t s\341\273\221 l\341\273\207nh th\341\273\261c thi trong Rhino \304\221\341\273\203 ng\341\272\257t v\303\262ng l\341\272\267p while ngay l\341\272\255p t\341\273\251c khi d\341\273\253ng\n */\nclass CancellableContextFactory : ContextFactory() {\n    override fun makeContext(): RhinoContext {\n        val cx = super.makeContext()\n        cx.instructionObserverThreshold = 50 // Gi\303\241m s\303\241t m\341\273\227i 50 l\341\273\207nh bytecode\n        return cx\n    }\n\n    override fun observeInstructionCount(cx: RhinoContext, instructionCount: Int) {\n        if (ExecutionManager.executionStatus.value == ExecutionStatus.IDLE) {\n            throw RuntimeException(\"Script b\341\273\213 d\341\273\253ng b\341\273\237i ng\306\260\341\273\235i d\303\271ng.\")\n        }\n        super.observeInstructionCount(cx, instructionCount)\n    }\n}\n\nclass ScriptRunner(private val context: Context) {\n\n    private val mainHandler = Handler(Looper.getMainLooper())\n\n    fun execute(scriptSource: String) {\n        val factory = CancellableContextFactory()\n        val rhino = factory.enterContext()\n        try {\n            rhino.optimizationLevel = -1 // Th\303\264ng d\341\273\213ch tr\341\273\261c ti\341\272\277p tr\303\252n Android VM\n            val scope: Scriptable = rhino.initStandardObjects()"
      }
