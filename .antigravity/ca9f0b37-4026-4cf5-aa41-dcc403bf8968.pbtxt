    instruction: "Add active script chip and change script button to toolbar"
    replacement_infos {
      original_chunk {
        target_content: "        // 1. N\303\272t T\341\272\241m d\341\273\253ng / Ti\341\272\277p t\341\273\245c\n        val btnPause = createToolbarButton(\"\342\217\270\", \"#FFD600\") {\n            ExecutionManager.triggerHaptic(this)\n            if (ExecutionManager.executionStatus.value == ExecutionStatus.PAUSED) {\n                ExecutionManager.resume()\n            } else if (ExecutionManager.executionStatus.value == ExecutionStatus.RUNNING) {\n                ExecutionManager.pause()\n            }\n        }\n        pauseIcon = btnPause\n        toolbar.addView(btnPause)\n\n        // 2. N\303\272t Ch\341\273\215n \304\220i\341\273\203m T\341\273\215a \304\220\341\273\231\n        toolbar.addView(createToolbarButton(\"\360\237\223\215\", \"#00E5FF\") {\n            ExecutionManager.triggerHaptic(this)\n            toggleExpandedToolbar(false)\n            showPointPickerOverlay()\n        })\n\n        // 3. N\303\272t Ch\341\273\215n V\303\271ng ROI\n        toolbar.addView(createToolbarButton(\"\360\237\224\262\", \"#7C4DFF\") {\n            ExecutionManager.triggerHaptic(this)\n            toggleExpandedToolbar(false)\n            showRoiPickerOverlay()\n        })\n\n        // 4. N\303\272t M\341\273\237 \341\273\250ng D\341\273\245ng Ch\303\255nh\n        toolbar.addView(createToolbarButton(\"\342\232\231\", \"#90CAF9\") {\n            ExecutionManager.triggerHaptic(this)\n            val appIntent = Intent(this, MainActivity::class.java).apply {\n                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)\n            }\n            startActivity(appIntent)\n            toggleExpandedToolbar(false)\n        })\n\n        // 5. N\303\272t \304\220\303\263ng N\303\272t N\341\273\225i\n        toolbar.addView(createToolbarButton(\"\342\234\226\", \"#EF5350\") {\n            ExecutionManager.triggerHaptic(this)\n            stopForeground(true)\n            stopSelf()\n        })"
        replacement_content: "        // 1. N\303\272t T\341\272\241m d\341\273\253ng / Ti\341\272\277p t\341\273\245c\n        val btnPause = createToolbarButton(\"\342\217\270\", \"#FFD600\") {\n            ExecutionManager.triggerHaptic(this)\n            if (ExecutionManager.executionStatus.value == ExecutionStatus.PAUSED) {\n                ExecutionManager.resume()\n            } else if (ExecutionManager.executionStatus.value == ExecutionStatus.RUNNING) {\n                ExecutionManager.pause()\n            }\n        }\n        pauseIcon = btnPause\n        toolbar.addView(btnPause)\n\n        // 2. Hi\341\273\203n th\341\273\213 T\303\252n Script Ho\341\272\241t \304\220\341\273\231ng\n        val scriptChip = LinearLayout(this).apply {\n            orientation = LinearLayout.HORIZONTAL\n            gravity = Gravity.CENTER_VERTICAL\n            setPadding((8 * density).toInt(), (4 * density).toInt(), (8 * density).toInt(), (4 * density).toInt())\n            val chipBg = GradientDrawable().apply {\n                cornerRadius = 14f\n                setColor(Color.parseColor(\"#331E88E5\"))\n                setStroke(1, Color.parseColor(\"#64B5F6\"))\n            }\n            background = chipBg\n            setOnClickListener {\n                ExecutionManager.triggerHaptic(this@FloatingControlService)\n                showScriptSelectorOverlay()\n            }\n        }\n        val scriptLabel = TextView(this).apply {\n            val cur = ExecutionManager.activeScript.value?.name ?: \"Ch\306\260a ch\341\273\215n script\"\n            text = \"\360\237\223\234 $cur\"\n            textSize = 11f\n            setTextColor(Color.WHITE)\n            paint.isFakeBoldText = true\n            maxLines = 1\n            maxWidth = (140 * density).toInt()\n        }\n        activeScriptLabel = scriptLabel\n        scriptChip.addView(scriptLabel)\n        toolbar.addView(scriptChip)\n\n        // 3. N\303\272t \304\220\341\273\225i Script nhanh\n        toolbar.addView(createToolbarButton(\"\360\237\224\204 \304\220\341\273\225i\", \"#64FFDA\") {\n            ExecutionManager.triggerHaptic(this)\n            showScriptSelectorOverlay()\n        })\n\n        // 4. N\303\272t Ch\341\273\215n \304\220i\341\273\203m T\341\273\215a \304\220\341\273\231\n        toolbar.addView(createToolbarButton(\"\360\237\223\215\", \"#00E5FF\") {\n            ExecutionManager.triggerHaptic(this)\n            toggleExpandedToolbar(false)\n            showPointPickerOverlay()\n        })\n\n        // 5. N\303\272t Ch\341\273\215n V\303\271ng ROI\n        toolbar.addView(createToolbarButton(\"\360\237\224\262\", \"#7C4DFF\") {\n            ExecutionManager.triggerHaptic(this)\n            toggleExpandedToolbar(false)\n            showRoiPickerOverlay()\n        })\n\n        // 6. N\303\272t M\341\273\237 \341\273\250ng D\341\273\245ng Ch\303\255nh\n        toolbar.addView(createToolbarButton(\"\342\232\231\", \"#90CAF9\") {\n            ExecutionManager.triggerHaptic(this)\n            val appIntent = Intent(this, MainActivity::class.java).apply {\n                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)\n            }\n            startActivity(appIntent)\n            toggleExpandedToolbar(false)\n        })\n\n        // 7. N\303\272t \304\220\303\263ng N\303\272t N\341\273\225i\n        toolbar.addView(createToolbarButton(\"\342\234\226\", \"#EF5350\") {\n            ExecutionManager.triggerHaptic(this)\n            stopForeground(true)\n            stopSelf()\n        })"
      }
      num_matches: 1
    }
  }
