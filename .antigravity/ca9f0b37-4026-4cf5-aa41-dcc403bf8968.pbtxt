      replacement_content: "        private fun checkCancelled() {\n            if (ExecutionManager.executionStatus.value == ExecutionStatus.IDLE) {\n                throw RuntimeException(\"Script b\341\273\213 d\341\273\253ng b\341\273\237i ng\306\260\341\273\235i d\303\271ng.\")\n            }\n            while (ExecutionManager.executionStatus.value == ExecutionStatus.PAUSED) {\n                Thread.sleep(150L)\n                if (ExecutionManager.executionStatus.value == ExecutionStatus.IDLE) {\n                    throw RuntimeException(\"Script b\341\273\213 d\341\273\253ng b\341\273\237i ng\306\260\341\273\235i d\303\271ng.\")\n                }\n            }\n        }\n\n        fun log(msg: Any?) {\n            LogRepository.info(\"Script\", msg?.toString() ?: \"null\")\n        }\n\n        fun toast(msg: Any?) {\n            val text = msg?.toString() ?: \"\"\n            mainHandler.post {\n                Toast.makeText(ctx, text, Toast.LENGTH_SHORT).show()\n            }\n        }\n\n        fun stop() {\n            ExecutionManager.stop()\n            throw RuntimeException(\"Script g\341\273\215i l\341\273\207nh stop().\")\n        }\n\n        fun pause() {\n            ExecutionManager.pause()\n        }\n\n        fun resume() {\n            ExecutionManager.resume()\n        }"
