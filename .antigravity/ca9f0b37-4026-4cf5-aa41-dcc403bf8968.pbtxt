    instruction: "Add showScriptSelectorOverlay and dismissScriptSelectorOverlay to FloatingControlService"
    replacement_infos {
      original_chunk {
        target_content: "    override fun onDestroy() {\n        super.onDestroy()\n        syncJob?.cancel()\n        removePointPicker()\n        removeRoiPicker()\n\n        rootContainer?.let {\n            windowManager.removeView(it)\n            rootContainer = null\n        }\n\n        ExecutionManager.floatingBubbleRect = null\n        ExecutionManager.onTemporarilyHideBubble = null\n        isRunning = false\n    }"
        replacement_content: "    /**\n     * Overlay chuy\341\273\203n \304\221\341\273\225i nhanh script \304\221ang ho\341\272\241t \304\221\341\273\231ng\n     */\n    private fun showScriptSelectorOverlay() {\n        if (scriptSelectorOverlay != null) return\n\n        val layoutType = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\n            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY\n        } else {\n            @Suppress(\"DEPRECATION\")\n            WindowManager.LayoutParams.TYPE_PHONE\n        }\n\n        val params = WindowManager.LayoutParams(\n            WindowManager.LayoutParams.MATCH_PARENT,\n            WindowManager.LayoutParams.MATCH_PARENT,\n            layoutType,\n            WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,\n            PixelFormat.TRANSLUCENT\n        )\n\n        val density = resources.displayMetrics.density\n\n        val root = FrameLayout(this).apply {\n            setBackgroundColor(Color.parseColor(\"#88000000\"))\n            setOnClickListener { dismissScriptSelectorOverlay() }\n        }\n\n        val dialogCard = LinearLayout(this).apply {\n            orientation = LinearLayout.VERTICAL\n            val bg = GradientDrawable().apply {\n                cornerRadius = 20 * density\n                setColor(Color.parseColor(\"#1C2030\"))\n                setStroke((1.5f * density).toInt(), Color.parseColor(\"#3D4868\"))\n            }\n            background = bg\n            setPadding((18 * density).toInt(), (16 * density).toInt(), (18 * density).toInt(), (16 * density).toInt())\n            elevation = 24f\n            val lp = FrameLayout.LayoutParams(\n                (320 * density).toInt().coerceAtMost((screenWidth * 0.9f).toInt()),\n                FrameLayout.LayoutParams.WRAP_CONTENT\n            ).apply {\n                gravity = Gravity.CENTER\n            }\n            layoutParams = lp\n            setOnClickListener { } // Ch\341\272\267n ch\341\272\241m xuy\303\252n n\341\273\201n\n        }\n\n        // Header\n        val headerLayout = LinearLayout(this).apply {\n            orientation = LinearLayout.HORIZONTAL\n            gravity = Gravity.CENTER_VERTICAL\n            val titleView = TextView(this@FloatingControlService).apply {\n                text = \"Ch\341\273\215n Script Ho\341\272\241t \304\220\341\273\231ng\"\n                textSize = 17f\n                setTextColor(Color.WHITE)\n                paint.isFakeBoldText = true\n                layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)\n            }\n            val closeBtn = TextView(this@FloatingControlService).apply {\n                text = \"\342\234\225\"\n                textSize = 18f\n                setTextColor(Color.parseColor(\"#AAAAAA\"))\n                setPadding((8 * density).toInt(), (4 * density).toInt(), (8 * density).toInt(), (4 * density).toInt())\n                setOnClickListener { dismissScriptSelectorOverlay() }\n            }\n            addView(titleView)\n            addView(closeBtn)\n        }\n        dialogCard.addView(headerLayout)\n\n        val subtitle = TextView(this).apply {\n            text = \"Script \304\221\306\260\341\273\243c ch\341\273\215n s\341\272\275 ch\341\272\241y khi b\341\272\241n b\341\272\245m n\303\272t Play \342\226\266 tr\303\252n n\303\272t n\341\273\225i.\"\n            textSize = 12f\n            setTextColor(Color.parseColor(\"#90CAF9\"))\n            setPadding(0, (4 * density).toInt(), 0, (12 * density).toInt())\n        }\n        dialogCard.addView(subtitle)\n\n        val scrollView = ScrollView(this).apply {\n            layoutParams = LinearLayout.LayoutParams(\n                LinearLayout.LayoutParams.MATCH_PARENT,\n                (280 * density).toInt()\n            )\n        }\n\n        val scriptListLayout = LinearLayout(this).apply {\n            orientation = LinearLayout.VERTICAL\n        }\n        scrollView.addView(scriptListLayout)\n        dialogCard.addView(scrollView)\n        root.addView(dialogCard)\n\n        // T\341\272\243i danh s\303\241ch script t\341\273\253 Room Database\n        scope.launch(Dispatchers.IO) {\n            val app = application as? SmartClickerApp\n            val scripts = app?.repository?.getAllScriptsList() ?: emptyList()\n\n            withContext(Dispatchers.Main) {\n                if (scripts.isEmpty()) {\n                    val emptyTv = TextView(this@FloatingControlService).apply {\n                        text = \"Ch\306\260a c\303\263 script n\303\240o trong th\306\260 vi\341\273\207n.\"\n                        setTextColor(Color.GRAY)\n                        textSize = 14f\n                        setPadding(0, 30, 0, 30)\n                        gravity = Gravity.CENTER\n                    }\n                    scriptListLayout.addView(emptyTv)\n                } else {\n                    val currentActive = ExecutionManager.activeScript.value\n                    scripts.forEach { script ->\n                        val isActive = currentActive?.id == script.id\n\n                        val itemCard = LinearLayout(this@FloatingControlService).apply {\n                            orientation = LinearLayout.VERTICAL\n                            setPadding((12 * density).toInt(), (10 * density).toInt(), (12 * density).toInt(), (10 * density).toInt())\n                            val itemBg = GradientDrawable().apply {\n                                cornerRadius = 12 * density\n                                setColor(if (isActive) Color.parseColor(\"#253450\") else Color.parseColor(\"#141724\"))\n                                setStroke(\n                                    (1 * density).toInt(),\n                                    if (isActive) Color.parseColor(\"#00E676\") else Color.parseColor(\"#2A3146\")\n                                )\n                            }\n                            background = itemBg\n                            val lp = LinearLayout.LayoutParams(\n                                LinearLayout.LayoutParams.MATCH_PARENT,\n                                LinearLayout.LayoutParams.WRAP_CONTENT\n                            ).apply {\n                                topMargin = (6 * density).toInt()\n                                bottomMargin = (6 * density).toInt()\n                            }\n                            layoutParams = lp\n\n                            setOnClickListener {\n                                ExecutionManager.triggerHaptic(this@FloatingControlService)\n                                ExecutionManager.setActiveScript(script, this@FloatingControlService)\n                                Toast.makeText(this@FloatingControlService, \"\304\220\303\243 ch\341\273\215n: ${script.name}\", Toast.LENGTH_SHORT).show()\n                                dismissScriptSelectorOverlay()\n                            }\n                        }\n\n                        val nameRow = LinearLayout(this@FloatingControlService).apply {\n                            orientation = LinearLayout.HORIZONTAL\n                            gravity = Gravity.CENTER_VERTICAL\n                            val nameTv = TextView(this@FloatingControlService).apply {\n                                text = script.name\n                                textSize = 14f\n                                setTextColor(if (isActive) Color.parseColor(\"#00E676\") else Color.WHITE)\n                                paint.isFakeBoldText = true\n                                layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)\n                            }\n                            addView(nameTv)\n\n                            if (isActive) {\n                                val activeBadge = TextView(this@FloatingControlService).apply {\n                                    text = \"\304\220ANG CH\341\273\214N \342\234\223\"\n                                    textSize = 10f\n                                    setTextColor(Color.parseColor(\"#00E676\"))\n                                    paint.isFakeBoldText = true\n                                }\n                                addView(activeBadge)\n                            }\n                        }\n                        itemCard.addView(nameRow)\n\n                        if (script.description.isNotEmpty()) {\n                            val descTv = TextView(this@FloatingControlService).apply {\n                                text = script.description\n                                textSize = 11f\n                                setTextColor(Color.parseColor(\"#A0AEC0\"))\n                                setPadding(0, 4, 0, 0)\n                            }\n                            itemCard.addView(descTv)\n                        }\n\n                        scriptListLayout.addView(itemCard)\n                    }\n                }\n            }\n        }\n\n        windowManager.addView(root, params)\n        scriptSelectorOverlay = root\n    }\n\n    private fun dismissScriptSelectorOverlay() {\n        scriptSelectorOverlay?.let {\n            try {\n                windowManager.removeView(it)\n            } catch (e: Exception) {\n                // ignore\n            }\n            scriptSelectorOverlay = null\n        }\n    }\n\n    override fun onDestroy() {\n        super.onDestroy()\n        syncJob?.cancel()\n        dismissScriptSelectorOverlay()\n        removePointPicker()\n        removeRoiPicker()\n\n        rootContainer?.let {\n            windowManager.removeView(it)\n            rootContainer = null\n        }\n\n        ExecutionManager.floatingBubbleRect = null\n        ExecutionManager.onTemporarilyHideBubble = null\n        isRunning = false\n    }"
      }
      num_matches: 1
    }
  }
}
