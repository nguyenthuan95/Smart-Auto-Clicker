      target_content: "    @Synchronized\n    fun captureCurrentFrame(): Bitmap? {\n        val reader = imageReader ?: return null\n        var image: Image? = null\n        try {\n            image = reader.acquireLatestImage() ?: return null\n            val plane = image.planes[0]\n            val buffer: ByteBuffer = plane.buffer\n            val pixelStride = plane.pixelStride\n            val rowStride = plane.rowStride\n            val rowPadding = rowStride - pixelStride * image.width\n\n            // T\341\272\241o bitmap t\341\273\253 buffer\n            val bitmap = Bitmap.createBitmap(\n                image.width + rowPadding / pixelStride,\n                image.height,\n                Bitmap.Config.ARGB_8888\n            )\n            bitmap.copyPixelsFromBuffer(buffer)\n\n            // C\341\272\257t ph\341\272\247n th\341\273\253a do row padding\n            return if (rowPadding > 0) {\n                val cropped = Bitmap.createBitmap(bitmap, 0, 0, image.width, image.height)\n                bitmap.recycle()\n                cropped\n            } else {\n                bitmap\n            }\n        } catch (e: Exception) {\n            LogRepository.error(\"ScreenCapture\", \"L\341\273\227i ch\341\273\245p m\303\240n h\303\254nh: ${e.message}\")\n            return null\n        } finally {\n            image?.close()\n        }\n    }"
      replacement_content: "    @Synchronized\n    fun captureCurrentFrame(): Bitmap? {\n        val reader = imageReader ?: return null\n        var image: Image? = null\n        try {\n            // T\341\272\241m \341\272\251n bong b\303\263ng n\341\273\225i (alpha = 0) \304\221\341\273\203 kh\303\264ng l\303\240m che khu\341\272\245t \341\272\243nh ch\341\273\245p\n            com.example.engine.ExecutionManager.onTemporarilyHideBubble?.invoke(true)\n            Thread.sleep(40L) // Cho ph\303\251p 1 frame c\341\273\247a UI buffer c\341\272\255p nh\341\272\255t\n\n            image = reader.acquireLatestImage() ?: return null\n            val plane = image.planes[0]\n            val buffer: ByteBuffer = plane.buffer\n            val pixelStride = plane.pixelStride\n            val rowStride = plane.rowStride\n            val rowPadding = rowStride - pixelStride * image.width\n\n            // T\341\272\241o bitmap t\341\273\253 buffer\n            val bitmap = Bitmap.createBitmap(\n                image.width + rowPadding / pixelStride,\n                image.height,\n                Bitmap.Config.ARGB_8888\n            )\n            bitmap.copyPixelsFromBuffer(buffer)\n\n            // C\341\272\257t ph\341\272\247n th\341\273\253a do row padding\n            return if (rowPadding > 0) {\n                val cropped = Bitmap.createBitmap(bitmap, 0, 0, image.width, image.height)\n                bitmap.recycle()\n                cropped\n            } else {\n                bitmap\n            }\n        } catch (e: Exception) {\n            LogRepository.error(\"ScreenCapture\", \"L\341\273\227i ch\341\273\245p m\303\240n h\303\254nh: ${e.message}\")\n            return null\n        } finally {\n            image?.close()\n            // Kh\303\264i ph\341\273\245c l\341\272\241i hi\341\273\203n th\341\273\213 bong b\303\263ng n\341\273\225i\n            com.example.engine.ExecutionManager.onTemporarilyHideBubble?.invoke(false)\n        }\n    }"
    }
