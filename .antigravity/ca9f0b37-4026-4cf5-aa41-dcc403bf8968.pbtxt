    replacement_chunks {
      target_content: "        // Thanh c\303\264ng c\341\273\245 th\341\273\261c thi d\306\260\341\273\233i c\303\271ng\n        Row(\n            modifier = Modifier.fillMaxWidth(),\n            horizontalArrangement = Arrangement.spacedBy(8.dp),\n            verticalAlignment = Alignment.CenterVertically\n        ) {\n            if (isRunning) {\n                Button(\n                    onClick = { ExecutionManager.stop() },\n                    colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.error),\n                    modifier = Modifier\n                        .weight(1f)\n                        .testTag(\"stop_script_button\")\n                ) {\n                    Icon(Icons.Default.Stop, contentDescription = null)\n                    Spacer(Modifier.width(8.dp))\n                    Text(\"D\341\273\253ng Ch\341\272\241y\")\n                }\n            } else {\n                Button(\n                    onClick = {\n                        val currentEntity = ScriptEntity(\n                            id = selectedScriptId ?: 0L,\n                            name = scriptName.ifEmpty { \"Script ch\341\272\241y th\341\273\255\" },\n                            description = scriptDesc,\n                            code = scriptCode\n                        )\n                        ExecutionManager.startScript(context, currentEntity)\n                    },\n                    modifier = Modifier\n                        .weight(1f)\n                        .testTag(\"run_script_button\")\n                ) {\n                    Icon(Icons.Default.PlayArrow, contentDescription = null)\n                    Spacer(Modifier.width(8.dp))\n                    Text(\"Ch\341\272\241y Th\341\273\255 Script\")\n                }\n            }\n        }"
      replacement_content: "        val activeScript by ExecutionManager.activeScript.collectAsStateWithLifecycle()\n        val isCurrentActive = selectedScriptId != null && activeScript?.id == selectedScriptId\n\n        // Thanh c\303\264ng c\341\273\245 th\341\273\261c thi d\306\260\341\273\233i c\303\271ng\n        Row(\n            modifier = Modifier.fillMaxWidth(),\n            horizontalArrangement = Arrangement.spacedBy(8.dp),\n            verticalAlignment = Alignment.CenterVertically\n        ) {\n            // N\303\272t g\303\241n l\303\240m Script ho\341\272\241t \304\221\341\273\231ng cho n\303\272t n\341\273\225i\n            OutlinedButton(\n                onClick = {\n                    val currentEntity = ScriptEntity(\n                        id = selectedScriptId ?: 0L,\n                        name = scriptName.ifEmpty { \"Script kh\303\264ng t\303\252n\" },\n                        description = scriptDesc,\n                        code = scriptCode\n                    )\n                    ExecutionManager.setActiveScript(currentEntity, context)\n                    Toast.makeText(context, \"\304\220\303\243 \304\221\341\272\267t \'${currentEntity.name}\' l\303\240m script c\341\273\247a n\303\272t n\341\273\225i!\", Toast.LENGTH_SHORT).show()\n                },\n                colors = if (isCurrentActive) {\n                    ButtonDefaults.outlinedButtonColors(\n                        containerColor = MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.4f),\n                        contentColor = MaterialTheme.colorScheme.primary\n                    )\n                } else ButtonDefaults.outlinedButtonColors()\n            ) {\n                Icon(\n                    if (isCurrentActive) Icons.Default.CheckCircle else Icons.Default.RadioButtonUnchecked,\n                    contentDescription = null,\n                    tint = if (isCurrentActive) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Spacer(Modifier.width(6.dp))\n                Text(if (isCurrentActive) \"\304\220ang Li\303\252n K\341\272\277t N\303\272t N\341\273\225i\" else \"Ch\341\273\215n Cho N\303\272t N\341\273\225i\")\n            }\n\n            if (isRunning) {\n                Button(\n                    onClick = { ExecutionManager.stop() },\n                    colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.error),\n                    modifier = Modifier\n                        .weight(1f)\n                        .testTag(\"stop_script_button\")\n                ) {\n                    Icon(Icons.Default.Stop, contentDescription = null)\n                    Spacer(Modifier.width(8.dp))\n                    Text(\"D\341\273\253ng Ch\341\272\241y\")\n                }\n            } else {\n                Button(\n                    onClick = {\n                        val currentEntity = ScriptEntity(\n                            id = selectedScriptId ?: 0L,\n                            name = scriptName.ifEmpty { \"Script ch\341\272\241y th\341\273\255\" },\n                            description = scriptDesc,\n                            code = scriptCode\n                        )\n                        ExecutionManager.startScript(context, currentEntity)\n                    },\n                    modifier = Modifier\n                        .weight(1f)\n                        .testTag(\"run_script_button\")\n                ) {\n                    Icon(Icons.Default.PlayArrow, contentDescription = null)\n                    Spacer(Modifier.width(8.dp))\n                    Text(\"Ch\341\272\241y Th\341\273\255\")\n                }\n            }\n        }"
    }
