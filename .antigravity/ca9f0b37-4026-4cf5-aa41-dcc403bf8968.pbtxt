 android:name=\"android.accessibilityservice.AccessibilityService\" />\n            </intent-filter>\n            <meta-data\n                android:name=\"android.accessibilityservice\"\n                android:resource=\"@xml/accessibility_service_config\" />\n        </service>\n\n        <!-- D\341\273\213ch v\341\273\245 Foreground ch\341\273\245p m\303\240n h\303\254nh v\341\273\233i MediaProjection -->\n        <service\n            android:name=\".service.ScreenCaptureService\"\n            android:exported=\"false\"\n            android:foregroundServiceType=\"mediaProjection\" />\n\n        <!-- D\341\273\213ch v\341\273\245 C\341\273\255a s\341\273\225 n\341\273\225i Overlay -->\n        <service\n            android:name=\".service.OverlayService\"\n            android:exported=\"false\" />\n\n        <!-- Quick Settings Tile \304\221\341\273\203 b\341\272\255t/t\341\272\257t nhanh t\341\273\253 thanh c\303\240i \304\221\341\272\267t nhanh -->\n        <service\n            android:name=\".service.SmartClickerTileService\"\n            android:exported=\"true\"\n            android:icon=\"@drawable/ic_launcher_foreground\"\n            android:label=\"@string/quick_tile_label\"\n            android:permission=\"android.permission.BIND_QUICK_SETTINGS_TILE\">\n            <intent-filter>\n                <action android:name=\"android.service.quicksettings.action.QS_TILE\" />\n            </intent-filter>\n        </service>\n\n    </application>\n\n</manifest>"
