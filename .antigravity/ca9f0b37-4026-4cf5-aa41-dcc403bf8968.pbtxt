      replacement_content: "        return when (step.stepType) {\n            StepType.CLICK_POINT -> {\n                val jitterX = step.x + (Random.nextFloat() * step.jitterRadius * 2 - step.jitterRadius)\n                val jitterY = step.y + (Random.nextFloat() * step.jitterRadius * 2 - step.jitterRadius)\n                if (ExecutionManager.isPointInsideFloatingBubble(jitterX, jitterY)) {\n                    LogRepository.warn(\"Macro\", \"T\341\273\215a \304\221\341\273\231 ($jitterX, $jitterY) tr\303\271ng n\303\272t n\341\273\225i, t\341\273\261 \304\221\341\273\231ng b\341\273\217 qua!\")\n                    false\n                } else {\n                    accessibility.click(jitterX, jitterY, step.durationMs)\n                }\n            }\n\n            StepType.DOUBLE_CLICK -> {\n                if (ExecutionManager.isPointInsideFloatingBubble(step.x, step.y)) false\n                else accessibility.doubleClick(step.x, step.y, step.durationMs)\n            }\n\n            StepType.LONG_PRESS -> {\n                if (ExecutionManager.isPointInsideFloatingBubble(step.x, step.y)) false\n                else accessibility.longPress(step.x, step.y, step.durationMs)\n            }\n\n            StepType.SWIPE -> {\n                accessibility.swipe(step.x, step.y, step.endX, step.endY, step.durationMs)\n            }\n\n            StepType.WAIT_TEXT_APPEAR -> {\n                waitForTextCondition(step, targetAppear = true)\n            }\n\n            StepType.WAIT_TEXT_DISAPPEAR -> {\n                waitForTextCondition(step, targetAppear = false)\n            }\n\n            StepType.CLICK_TEXT -> {\n                val element = findTextWithOcr(step)\n                if (element != null) {\n                    val jitterX = element.centerX + (Random.nextFloat() * 4f - 2f)\n                    val jitterY = element.centerY + (Random.nextFloat() * 4f - 2f)\n                    if (ExecutionManager.isPointInsideFloatingBubble(jitterX