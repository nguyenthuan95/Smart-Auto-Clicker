      name: "create_file"
      arguments_json: "{\"Content\":\"package com.example.engine\\n\\nimport com.example.data.model.ScriptEntity\\n\\nobject SampleScripts {\\n\\n    val script1SkipButton = ScriptEntity(\\n        name = \\\"1. T\341\273\261 \304\221\341\273\231ng b\341\272\245m \'Skip / B\341\273\217 qua\'\\\",\\n        description = \\\"Li\303\252n t\341\273\245c qu\303\251t to\303\240n m\303\240n h\303\254nh ho\341\272\267c v\303\271ng ch\341\273\215n, khi th\341\272\245y ch\341\273\257 \'Skip\', \'B\341\273\217 qua\', \'\304\220\303\263ng\' ho\341\272\267c \'X\' th\303\254 t\341\273\261 click v\303\240o t\303\242m n\303\272t.\\\",\\n        isPreset = true,\\n        code = \\\"\\\"\\\"\\n// Script: T\341\273\261 \304\221\341\273\231ng b\341\272\245m Skip / B\341\273\217 qua qu\341\272\243ng c\303\241o ho\341\272\267c m\303\240n h\303\254nh ch\341\273\235\\nlog(\\\"B\341\272\257t \304\221\341\272\247u gi\303\241m s\303\241t n\303\272t Skip / B\341\273\217 qua...\\\");\\ntoast(\\\"\304\220ang t\303\254m n\303\272t B\341\273\217 qua...\\\");\\n\\nvar loopCount = 0;\\nvar maxLoops = 100; // Gi\341\273\233i h\341\272\241n ki\341\273\203m tra tr\303\241nh l\341\272\267p v\303\264 t\341\272\255n\\n\\nwhile (loopCount < maxLoops) {\\n    // T\303\254m c\303\241c t\341\273\253 kh\303\263a ph\341\273\225 bi\341\272\277n: \'B\341\273\217 qua\', \'Skip\', \'\304\220\303\263ng\', \'Close\'\\n    var btn = findText(\\\"B\341\273\217 qua\\\") || findText(\\\"Skip\\\") || findText(\\\"\304\220\303\263ng\\\") || findText(\\\"Close\\\");\\n    \\n    if (btn) {\\n        log(\\\"=> T\303\254m th\341\272\245y n\303\272t: \'\\\" + btn.text + \\\"\' t\341\272\241i (\\\" + btn.centerX + \\\", \\\" + btn.centerY + \\\")\\\");\\n        // Th\303\252m \304\221\341\273\231 l\341\273\207ch ng\341\272\253u nhi\303\252n nh\341\273\217 v\303\240 b\341\272\245m\\n        click(btn.centerX, btn.centerY);\\n        toast(\\\"\304\220\303\243 b\341\272\245m \\\" + btn.text);\\n        sleep(1000);\\n    } else {\\n        log(\\\"Ch\306\260a th\341\272\245y n\303\272t Skip, \304\221ang qu\303\251t l\341\272\241i (l\341\272\247n \\\" + (loopCount + 1) + \\\")\\\");\\n    }\\n    \\n    loopCount++;\\n    sleep(1500); // Ngh\341\273\211 1.5 gi\303\242y gi\341\273\257a c\303\241c l\341\272\247n qu\303\251t\\n}\\n\\nlog(\\\"Ho\303\240n th\303\240nh chu k\341\273\263 gi\303\241m s\303\241t.\\\");\\n\\\"\\\"\\\".trimIndent()\\n    )\\n\\n    val script2AutoPasteAndSend = ScriptEntity(\\n        name = \\\"2. T\341\273\261 d\303\241n v\304\203n b\341\272\243n v\303\240 b\341\272\245m \'G\341\273\255i\'\\\",\\n        description = \\\"\304\220\341\272\267t n\341\273\231i dung clipboard, ch\341\272\241m v\303\240o \303\264 nh\341\272\255p tin nh\341\272\257n \304\221\341\273\203 focus, d\303\241n n\341\273\231i dung r\341\273\223i t\341\273\261 t\303\254m n\303\272t \'G\341\273\255i\' / \'Send\' \304\221\341\273\203 b\341\272\245m.\\\",\\n        isPreset = true,\\n        code = \\\"\\\"\\\"\\n// Script: T\341\273\261 \304\221\341\273\231ng d\303\241n v\304\203n b\341\272\243n v\303\240o \303\264 chat v\303\240 b\341\272\245m G\341\273\255i\\nlog(\\\"B\341\272\257t \304\221\341\272\247u k\341\273\213ch b\341\272\243n D\303\241n & G\341\273\255i tin nh\341\272\257n...\\\");\\n\\n// 1. Chu\341\272\251n b\341\273\213 n\341\273\231i dung c\341\272\247n d\303\241n\\nvar message = \\\"Xin ch\303\240o! \304\220\303\242y l\303\240 tin nh\341\272\257n g\341\273\255i t\341\273\261 \304\221\341\273\231ng t\341\273\253 Smart Auto Clicker. (\\\" + new Date().toLocaleTimeString() + \\\")\\\";\\nsetClipboard(message);\\nlog(\\\"\304\220\303\243 c\341\272\255p nh\341\272\255t clipboard: \\\" + message);\\n\\n// 2. T\303\254m \303\264 nh\341\272\255p v\304\203n b\341\272\243n (th\306\260\341\273\235ng ch\341\273\251a \'Nh\341\272\255p\', \'Nh\341\272\257n tin\', \'Type\', \'Message\')\\nvar inputField = findText(\\\"Nh\341\272\255p\\\") || findText(\\\"Nh\341\272\257n tin\\\") || findText(\\\"Type\\\") || findText(\\\"Message\\\");\\n\\nif (inputField) {\\n    log(\\\"T\303\254m th\341\272\245y \303\264 nh\341\272\255p t\341\272\241i: (\\\" + inputField.centerX + \\\", \\\" + inputField.centerY + \\\")\\\");\\n    // Ch\341\272\241m v\303\240o \303\264 nh\341\272\255p v\303\240 th\341\273\261c hi\341\273\207n d\303\241n\\n    pasteClipboard(inputField.centerX, inputField.centerY);\\n    sleep(800);\\n} else {\\n    // N\341\272\277u kh\303\264ng t\303\254m th\341\272\245y b\341\272\261ng OCR, d\303\241n t\341\272\241i v\341\273\213 tr\303\255 \306\260\341\273\233c l\306\260\341\273\243ng \304\221\303\241y m\303\240n h\303\254nh\\n    var size = screenSize();\\n    var defaultX = size.width / 2;\\n    var defaultY = size.height - 150;\\n    log(\\\"Kh\303\264ng th\341\272\245y \303\264 nh\341\272\255p qua OCR, th\341\273\255 d\303\241n t\341\272\241i v\341\273\213 tr\303\255 m\341\272\267c \304\221\341\273\213nh (\\\" + defaultX + \\\", \\\" + defaultY + \\\")\\\");\\n    pasteClipboard(defaultX, defaultY);\\n    sleep(800);\\n}\\n\\n// 3. T\303\254m n\303\272t \'G\341\273\255i\' ho\341\272\267c \'Send\'\\nvar sendBtn = findText(\\\"G\341\273\255i\\\") || findText(\\\"Send\\\");\\nif (sendBtn) {\\n    log(\\\"T\303\254m th\341\272\245y n\303\272t G\341\273\255i t\341\272\241i (\\\" + sendBtn.centerX + \\\", \\\" + sendBtn.centerY + \\\")\\\");\\n    click(sendBtn.centerX, sendBtn.centerY);\\n    toast(\\\"\304\220\303\243 g\341\273\255i tin nh\341\272\257n th\303\240nh c\303\264ng!\\\");\\n} else {\\n    log(\\\"Kh\303\264ng th\341\272\245y n\303\272t G\341\273\255i, b\341\272\241n c\303\263 th\341\273\203 b\341\273\225 sung t\341\273\215a \304\221\341\273\231 c\341\273\221 \304\221\341\273\213nh n\303\272t g\341\273\255i.\\\");\\n}\\n\\\"\\\"\\\".trimIndent()\\n    )\\n\\n    val script3LoopWithExitCondition = ScriptEntity(\\n        name = \\\"3. V\303\262ng l\341\272\267p c\303\263 \304\221i\341\273\201u ki\341\273\207n tho\303\241t\\\",\\n        description = \\\"Th\341\273\261c hi\341\273\207n chu\341\273\227i h\303\240nh \304\221\341\273\231ng l\341\272\267p (vu\341\273\221t m\303\240n h\303\254nh, ki\341\273\203m tra OCR), t\341\273\261 \304\221\341\273\231ng d\341\273\253ng khi th\341\273\217a m\303\243n \304\221i\341\273\201u ki\341\273\207n ho\341\272\267c h\341\272\277t s\341\273\221 l\341\272\247n t\341\273\221i \304\221a.\\\",\\n        isPreset = true,\\n        code = \\\"\\\"\\\"\\n// Script: L\341\272\267p cu\341\273\231n tin t\341\273\251c / trang v\303\240 d\341\273\253ng khi g\341\272\267p t\341\273\253 kh\303\263a m\341\273\245c ti\303\252u\\nlog(\\\"B\341\272\257t \304\221\341\272\247u v\303\262ng l\341\272\267p t\303\254m ki\341\272\277m n\341\273\231i dung quan t\303\242m...\\\");\\n\\nvar targetWord = \\\"Khuy\341\272\277n m\303\243i\\\";\\nvar size = screenSize();\\nvar startX = size.width / 2;\\nvar startY = size.height * 0.75;\\nvar endY = size.height * 0.25;\\n\\nvar maxScrolls = 20;\\nvar found = false;\\n\\nfor (var i = 1; i <= maxScrolls; i++) {\\n    log(\\\"--- L\341\272\247n duy\341\273\207t th\341\273\251 \\\" + i + \\\"/\\\" + maxScrolls + \\\" ---\\\");\\n    \\n    // Ki\341\273\203m tra xem t\341\273\253 kh\303\263a m\341\273\245c ti\303\252u \304\221\303\243 xu\341\272\245t hi\341\273\207n tr\303\252n m\303\240n h\303\254nh ch\306\260a\\n    var result = findText(targetWord);\\n    if (result) {\\n        log(\\\"\360\237\216\211 \304\220\303\203 T\303\214M TH\341\272\244Y: \'\\\" + result.text + \\\"\' t\341\272\241i t\341\273\215a \304\221\341\273\231 (\\\" + result.centerX + \\\", \\\" + result.centerY + \\\")\\\");\\n        toast(\\\"T\303\254m th\341\272\245y m\341\273\245c ti\303\252u! \304\220ang m\341\273\237...\\\");\\n        click(result.centerX, result.centerY);\\n        found = true;\\n        break; // Tho\303\241t v\303\262ng l\341\272\267p\\n    }\\n    \\n    // Ch\306\260a th\341\272\245y, th\341\273\261c hi\341\273\207n vu\341\273\221t cu\341\273\231n m\303\240n h\303\254nh l\303\252n\\n    log(\\\"Ch\306\260a th\341\272\245y t\341\273\253 kh\303\263a \'\\\" + targetWord + \\\"\', \304\221ang cu\341\273\231n m\303\240n h\303\254nh...\\\");\\n    swipe(startX, startY, startX, endY, 450);\\n    sleep(1200); // \304\220\341\273\243i m\303\240n h\303\254nh \341\273\225n \304\221\341\273\213nh sau khi cu\341\273\231n\\n}\\n\\nif (!found) {\\n    log(\\\"\304\220\303\243 \304\221\341\272\241t gi\341\273\233i h\341\272\241n \\\" + maxScrolls + \\\" l\341\272\247n cu\341\273\231n m\303\240 kh\303\264ng th\341\272\245y \'\\\" + targetWord + \\\"\'. D\341\273\253ng l\341\272\241i.\\\");\\n    toast(\\\"Kh\303\264ng t\303\254m th\341\272\245y n\341\273\231i dung m\341\273\245c ti\303\252u.\\\");\\n}\\n\\\"\\\"\\\".trimIndent()\\n    )\\n\\n    val script4UnexpectedPopup = ScriptEntity(\\n        name = \\\"4. X\341\273\255 l\303\275 popup b\341\272\245t ng\341\273\235\\\",\\n        description = \\\"H\303\240m ti\341\273\207n \303\255ch qu\303\251t v\303\240 t\341\273\261 \304\221\341\273\231ng \304\221\303\263ng c\303\241c h\341\273\231p tho\341\272\241i, b\341\272\243ng th\303\264ng b\303\241o, quy\341\273\201n ho\341\272\267c c\341\272\243nh b\303\241o b\341\272\245t ng\341\273\235 chen ngang.\\\",\\n        isPreset = true,\\n        code = \\\"\\\"\\\"\\n// Script: T\341\273\261 \304\221\341\273\231ng nh\341\272\255n di\341\273\207n v\303\240 \304\221\303\263ng popup / th\303\264ng b\303\241o b\341\272\245t ng\341\273\235\\nlog(\\\"B\341\272\257t \304\221\341\272\247u ki\341\273\203m tra v\303\240 d\341\273\215n d\341\272\271p popup b\341\272\245t ng\341\273\235...\\\");\\n\\n// Danh s\303\241ch c\303\241c t\341\273\253 kh\303\263a n\303\272t \304\221\303\263ng popup ph\341\273\225 bi\341\272\277n\\nvar closeKeywords = [\\\"T\303\264i \304\221\303\243 hi\341\273\203u\\\", \\\"\304\220\341\273\223ng \303\275\\\", \\\"B\341\273\217 qua\\\", \\\"\304\220\303\263ng\\\", \\\"Kh\303\264ng c\341\272\243m \306\241n\\\", \\\"H\341\273\247y\\\", \\\"OK\\\", \\\"Dismiss\\\"];\\n\\nfunction checkAndDismissPopup() {\\n    for (var i = 0; i < closeKeywords.length; i++) {\\n        var keyword = closeKeywords[i];\\n        var btn = findText(keyword);\\n        if (btn) {\\n            log(\\\"Ph\303\241t hi\341\273\207n popup c\303\263 n\303\272t: \'\\\" + keyword + \\\"\' t\341\272\241i (\\\" + btn.centerX + \\\", \\\" + btn.centerY + \\\")\\\");\\n            click(btn.centerX, btn.centerY);\\n            toast(\\\"\304\220\303\243 t\341\272\257t popup: \\\" + keyword);\\n            sleep(1000);\\n            return true;\\n        }\\n    }\\n    return false;\\n}\\n\\n// V\303\262ng l\341\272\267p m\303\264 ph\341\273\217ng: th\341\273\261c hi\341\273\207n c\303\264ng vi\341\273\207c ch\303\255nh xen k\341\272\275 ki\341\273\203m tra popup\\nfor (var step = 1; step <= 5; step++) {\\n    log(\\\"Th\341\273\261c hi\341\273\207n t\303\241c v\341\273\245 ch\303\255nh b\306\260\341\273\233c \\\" + step + \\\"...\\\");\\n    \\n    // Ki\341\273\203m tra xem c\303\263 popup che khu\341\272\245t kh\303\264ng\\n    if (checkAndDismissPopup()) {\\n        log(\\\"\304\220\303\243 gi\341\272\243i quy\341\272\277t popup, ti\341\272\277p t\341\273\245c t\303\241c v\341\273\245...\\\");\\n    }\\n    \\n    // Thao t\303\241c ch\303\255nh v\303\255 d\341\273\245: ch\341\272\241m gi\341\273\257a m\303\240n h\303\254nh\\n    var size = screenSize();\\n    click(size.width / 2, size.height / 2);\\n    \\n    sleep(2000);\\n}\\n\\nlog(\\\"Ho\303\240n th\303\240nh t\303\241c v\341\273\245 c\303\263 b\341\272\243o v\341\273\207 ch\341\273\221ng popup.\\\");\\n\\\"\\\"\\\".trimIndent()\\n    )\\n\\n    val script5RetryOnMissingText = ScriptEntity(\\n        name = \\\"5. Th\341\273\255 l\341\272\241i khi kh\303\264ng th\341\272\245y ch\341\273\257 (Retry Pattern)\\\",\\n        description = \\\"Th\341\273\261c hi\341\273\207n t\303\254m ki\341\272\277m ch\341\273\257 v\341\273\233i c\306\241 ch\341\272\277 th\341\273\255 l\341\272\241i (Retry) c\303\263 exponential backoff, gi\341\273\233i h\341\272\241n timeout v\303\240 th\303\264ng b\303\241o tr\341\272\241ng th\303\241i.\\\",\\n        isPreset = true,\\n        code = \\\"\\\"\\\"\\n// Script: Th\341\273\255 l\341\272\241i (Retry) th\303\264ng minh khi ch\341\273\235 ch\341\273\257 xu\341\272\245t hi\341\273\207n\\nlog(\\\"Kh\341\273\237i ch\341\272\241y c\306\241 ch\341\272\277 ch\341\273\235 v\303\240 th\341\273\255 l\341\272\241i...\\\");\\n\\nfunction waitForTextWithRetry(targetText, maxRetries, waitIntervalMs) {\\n    log(\\\"\304\220ang \304\221\341\273\243i ch\341\273\257: \'\\\" + targetText + \\\"\' (t\341\273\221i \304\221a \\\" + maxRetries + \\\" l\341\272\247n th\341\273\255)...\\\");\\n    \\n    for (var attempt = 1; attempt <= maxRetries; attempt++) {\\n        log(\\\"Th\341\273\255 l\341\272\247n \\\" + attempt + \\\"/\\\" + maxRetries + \\\": \304\221ang qu\303\251t OCR...\\\");\\n        var element = findText(targetText);\\n        \\n        if (element) {\\n            log(\\\"\342\234\223 Th\303\240nh c\303\264ng t\341\272\241i l\341\272\247n th\341\273\255 \\\" + attempt + \\\"! T\303\254m th\341\272\245y \'\\\" + element.text + \\\"\'\\\");\\n            return element;\\n        }\\n        \\n        if (attempt < maxRetries) {\\n            // Ch\341\273\235 tr\306\260\341\273\233c khi th\341\273\255 l\341\272\241i\\n            log(\\\"Ch\306\260a th\341\272\245y, ch\341\273\235 \\\" + waitIntervalMs + \\\"ms \304\221\341\273\203 th\341\273\255 l\341\272\241i...\\\");\\n            sleep(waitIntervalMs);\\n        }\\n    }\\n    \\n    log(\\\"\342\234\227 H\341\272\277t s\341\273\221 l\341\272\247n th\341\273\255! Kh\303\264ng t\303\254m th\341\272\245y: \\\" + targetText);\\n    return null;\\n}\\n\\n// S\341\273\255 d\341\273\245ng h\303\240m th\341\273\255 l\341\272\241i: t\303\254m ch\341\273\257 \'B\341\272\257t \304\221\341\272\247u\' ho\341\272\267c \'Ti\341\272\277p t\341\273\245c\'\\nvar button = waitForTextWithRetry(\\\"B\341\272\257t \304\221\341\272\247u\\\", 5, 2000);\\n\\nif (button) {\\n    click(button.centerX, button.centerY);\\n    toast(\\\"\304\220\303\243 b\341\272\245m: \\\" + button.text);\\n} else {\\n    toast(\\\"Kh\303\264ng th\341\272\245y ch\341\273\257 sau nhi\341\273\201u l\341\272\247n th\341\273\255, an to\303\240n d\341\273\253ng l\341\272\241i.\\\");\\n    stop();\\n}\\n\\\"\\\"\\\".trimIndent()\\n    )\\n\\n    val allPresets = listOf(\\n        script1SkipButton,\\n        script2AutoPasteAndSend,\\n        script3LoopWithExitCondition,\\n        script4UnexpectedPopup,\\n        script5RetryOnMissingText\\n    )\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/app/src/main/java/com/example/engine/SampleScripts.kt\", \"toolAction\":\"Creating sample scripts\", \"toolSummary\":\"Create SampleScripts.kt\"}"
      thought_signature: ""
      original_name: "create_file"
    }
